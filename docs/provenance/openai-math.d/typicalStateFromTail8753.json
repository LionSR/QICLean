      "license": "Apache-2.0",
      "notices": [],
      "changes": [
        "For a trace-one positive density, use the existing canonical Entropy.typicalSet of its actual eigenvalues centered at its own entropy. A spectral tail bound at most \u03b4<1 implies selected mass at least 1\u2212\u03b4 and positive mass. The existing actual normalized spectral restriction is positive semidefinite with trace one, rank equal to the typical-set cardinality, and logarithmic-rank and entropy errors at most w\u2212log(1\u2212\u03b4). This is a finite-dimensional conditional consequence, not the physical or asymptotic concentration specialization. No new typical-set or density definition, full-rank hypothesis, supplied coordinate or assumed positive mass is introduced."
      ],
      "no_upstream_proof_text_reused": true,
      "verification": {
        "result": "passed",
