theorem Matrix.partialTraceRight_replicaExcitationComponent_goodAuxiliary_density.{u_1, u_2} : ∀ {A : Type u_1}
  {C : Type u_2} [inst : Fintype A] [inst_1 : DecidableEq A] [inst_2 : Fintype C] [inst_3 : DecidableEq C] (Ω : A → ℂ),
  ‖WithLp.toLp 2 Ω‖ = 1 →
    ∀ {k : ℕ} (B : Finset (Fin k)) (u : (Fin k → A) × C → ℂ),
      have w := (Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u;
      have φ := fun g ↦ ∏ i, Ω (g i);
      have f := fun x ↦ w ((FiniteProduct.splitEquiv (fun x ↦ A) B).symm (x.2, x.1.1), x.1.2);
      (Matrix.vecMulVec f (star f)).partialTraceRight =
        Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2) (Matrix.vecMulVec φ (star φ))
          (Matrix.vecMulVec w (star w)).partialTraceLeft :=
fun {A} {C} [Fintype A] [DecidableEq A] [Fintype C] [DecidableEq C] Ω hΩ {k} B u ↦
  id
