                      ((FiniteProduct.splitEquiv (fun x ↦ A) B).symm (x.2, x.1.1), x.1.2))
                  (star fun x ↦
                    (Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u
                      ((FiniteProduct.splitEquiv (fun x ↦ A) B).symm (x.2, x.1.1), x.1.2))).partialTraceRight =
              Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2)
                (Matrix.vecMulVec (fun g ↦ ∏ i, Ω (g i)) (star fun g ↦ ∏ i, Ω (g i))) _a)
          (Matrix.partialTraceLeft_replicaExcitationComponent_eq_remainder Ω hΩ B u)))
