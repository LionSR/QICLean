@Matrix.PosSemidef.re_trace_mul_exp_smul_add_le : ∀ {n : Type u_1} [inst : Fintype n] [inst_1 : DecidableEq n]
  {ρ A B : Matrix n n ℂ},
  ρ.PosSemidef →
    A.IsHermitian →
      B.IsHermitian →
        Commute A B →
          ∀ (t : ℝ),
            0 ≤ t →
              t ≤ 1 →
                (ρ * NormedSpace.exp (↑t • A + ↑(1 - t) • B)).trace.re ≤
                  (ρ * NormedSpace.exp A).trace.re ^ t * (ρ * NormedSpace.exp B).trace.re ^ (1 - t)
@Matrix.PosSemidef.re_trace_mul_exp_sum_le_prod : ∀ {n : Type u_1} [inst : Fintype n] [inst_1 : DecidableEq n]
  {ρ : Matrix n n ℂ},
  ρ.PosSemidef →
    ∀ (m : ℕ) (A : Fin (m + 1) → Matrix n n ℂ),
      (∀ (i : Fin (m + 1)), (A i).IsHermitian) →
        (∀ (i j : Fin (m + 1)), Commute (A i) (A j)) →
          ∀ (a : ℝ),
            (ρ * NormedSpace.exp (↑a • ∑ i, A i)).trace.re ≤
              ∏ i, (ρ * NormedSpace.exp (↑(↑(m + 1) * a) • A i)).trace.re ^ (1 / ↑(m + 1))
@Matrix.PosSemidef.re_trace_mul_exp_nonneg : ∀ {n : Type u_1} [inst : Fintype n] [inst_1 : DecidableEq n]
  {ρ A : Matrix n n ℂ}, ρ.PosSemidef → A.IsHermitian → 0 ≤ (ρ * NormedSpace.exp A).trace.re
@PermutationRepresentation.joint_hom_fst : ∀ {G : Type u_1} {X : Type u_2} [inst : Group G] [inst_1 : Fintype G]
  [inst_2 : Fintype X] [inst_3 : DecidableEq X] {φ : G →* Equiv.Perm X} {ρ : Matrix X X ℂ} (hρ : ρ.PosSemidef)
  (hinv : ∀ (g : G), Commute ((PermutationRepresentation.permOp φ) g) ρ) (f : ℝ → ℝ),
  (⋯.hom fun p => ↑(f ↑p.1)) = ⋯.cfc f
@PermutationRepresentation.joint_hom_snd : ∀ {G : Type u_1} {X : Type u_2} [inst : Group G] [inst_1 : Fintype G]
  [inst_2 : Fintype X] [inst_3 : DecidableEq X] {φ : G →* Equiv.Perm X} {ρ : Matrix X X ℂ} (hρ : ρ.PosSemidef)
  (hinv : ∀ (g : G), Commute ((PermutationRepresentation.permOp φ) g) ρ) (f : IrrepLabel G → ℝ),
  (⋯.hom fun p => ↑(f p.2)) = PermutationRepresentation.labelObservable φ f
@TensorPower.groupedCopies_labelEntropy_bounds : ∀ {m r k : ℕ} (e : Fin m ⊕ Fin r ≃ Fin k) {X : Type u_1}
  [inst : Fintype X] [inst_1 : DecidableEq X] (φ : Equiv.Perm (Fin k) →* Equiv.Perm X),
  PermutationRepresentation.labelEntropy (φ.comp (TensorPower.groupHom₁ e)) +
        PermutationRepresentation.labelEntropy (φ.comp (TensorPower.groupHom₂ e)) ≤
      PermutationRepresentation.labelEntropy φ ∧
    PermutationRepresentation.labelEntropy φ ≤
      PermutationRepresentation.labelEntropy (φ.comp (TensorPower.groupHom₁ e)) +
          PermutationRepresentation.labelEntropy (φ.comp (TensorPower.groupHom₂ e)) +
        ↑(Real.log ↑(k.choose r)) • 1
@PermutationRepresentation.exp_mergeDeficit_eq_sum : ∀ {G : Type u_1} {X : Type u_2} [inst : Group G]
  [inst_1 : Fintype G] [inst_2 : Fintype X] [inst_3 : DecidableEq X] {φQ φE φQE : G →* Equiv.Perm X},
  (∀ (g h : G), Commute (φQ g) (φE h)) →
    (∀ (g : G), φQE g = φQ g * φE g) →
      ∀ (b : ℝ),
        NormedSpace.exp
            (↑b •
              (PermutationRepresentation.labelEntropy φQ + PermutationRepresentation.labelEntropy φE -
                PermutationRepresentation.labelEntropy φQE)) =
          ∑ l,
            ∑ μ,
              ∑ ν,
                ↑((↑(l.dim * μ.dim) / ↑ν.dim) ^ b) •
                  (PermutationRepresentation.labelProj φQ l * PermutationRepresentation.labelProj φE μ *
                    PermutationRepresentation.labelProj φQE ν)
@PermutationRepresentation.re_trace_mul_exp_mergeDeficit_eq_sum : ∀ {G : Type u_1} {X : Type u_2} [inst : Group G]
  [inst_1 : Fintype G] [inst_2 : Fintype X] [inst_3 : DecidableEq X] {φQ φE φQE : G →* Equiv.Perm X},
  (∀ (g h : G), Commute (φQ g) (φE h)) →
    (∀ (g : G), φQE g = φQ g * φE g) →
      ∀ (b : ℝ) (ρ : Matrix X X ℂ),
        (ρ *
                NormedSpace.exp
                  (↑b •
                    (PermutationRepresentation.labelEntropy φQ + PermutationRepresentation.labelEntropy φE -
                      PermutationRepresentation.labelEntropy φQE))).trace.re =
          ∑ l,
            ∑ μ,
              ∑ ν,
                (ρ *
                        (PermutationRepresentation.labelProj φQ l * PermutationRepresentation.labelProj φE μ *
                          PermutationRepresentation.labelProj φQE ν)).trace.re *
                  (↑(l.dim * μ.dim) / ↑ν.dim) ^ b
@PermutationRepresentation.posSemidef_mergeDeficit : ∀ {G : Type u_1} {X : Type u_2} [inst : Group G]
  [inst_1 : Fintype G] [inst_2 : Fintype X] [inst_3 : DecidableEq X] {φQ φE φQE : G →* Equiv.Perm X},
  (∀ (g h : G), Commute (φQ g) (φE h)) →
    (∀ (g : G), φQE g = φQ g * φE g) →
      (PermutationRepresentation.labelEntropy φQ + PermutationRepresentation.labelEntropy φE -
          PermutationRepresentation.labelEntropy φQE).PosSemidef
