@Matrix.replicaGoodRegionalAuxiliaryMarginal_exp_mergeDeficit_le : ∀ {Q : Type u_1} {T : Type u_2} {C : Type u_3}
  {D : Type u_4} [inst : Fintype Q] [inst_1 : DecidableEq Q] [inst_2 : Fintype T] [inst_3 : DecidableEq T]
  [inst_4 : Fintype C] [inst_5 : DecidableEq C] [inst_6 : Fintype D] [inst_7 : DecidableEq D] (Ω : Q × T → ℂ),
  ‖WithLp.toLp 2 Ω‖ = 1 →
    ∀ (k : ℕ) (B : Finset (Fin k)) (u : (Fin k → Q × T) × (Fin k → C) × (Fin k → D) → ℂ),
      (∀ (σ : Equiv.Perm (Fin k)),
          (Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2)
                  ((PermutationRepresentation.permOp (TensorPower.copyPerm (Q × T) k)) σ)
                  (Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2)
                    ((PermutationRepresentation.permOp (TensorPower.copyPerm C k)) σ)
                    ((PermutationRepresentation.permOp (TensorPower.copyPerm D k)) σ))).mulVec
              u =
            u) →
        ∀ {b : ℝ},
          b ≤ 1 →
            let m := Bᶜ.card;
            have ρ := Matrix.replicaGoodRegionalAuxiliaryMarginal Ω k B u;
            have w := (Matrix.kroneckerMap (fun x1 x2 ↦ x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u;
            (ρ *
                    NormedSpace.exp
                      (↑b •
                        (PermutationRepresentation.labelEntropy (TensorPower.pairCopyLeft Q C m) +
                            PermutationRepresentation.labelEntropy (TensorPower.pairCopyRight Q C m) -
                          PermutationRepresentation.labelEntropy (TensorPower.pairCopyBoth Q C m)))).trace.re ≤
              ↑((m + 1) ^ (Fintype.card Q * Fintype.card C) ^ 2) * ‖WithLp.toLp 2 w‖ ^ 2
