theorem TensorPower.copyPerm_groupedCopies_labelEntropy_bounds.{u_1} : ∀ {m r k : ℕ} (e : Fin m ⊕ Fin r ≃ Fin k)
  {C : Type u_1} [inst : Fintype C] [inst_1 : DecidableEq C],
  PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)) ≤
      (↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1 ∧
    PermutationRepresentation.labelEntropy (TensorPower.copyPerm C k) ≤
      PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) +
        (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) • 1 :=
fun {m r k} e {C} [Fintype C] [DecidableEq C] =>
  have hLog := fun β hβ =>
    have hd :=
      cast (Eq.symm (Eq.trans (congrArg (LE.le ↑β.dim) (Nat.cast_pow._simp_1 (Fintype.card C) r)) Nat.cast_le._simp_1))
        (TensorPower.groupHom₂_labelProj_dim_le e β hβ);
    Eq.mp (congrArg (LE.le (Real.log ↑β.dim)) (Real.log_pow (↑(Fintype.card C)) r))
      (Real.log_le_log (Nat.cast_pos.mpr (IrrepLabel.dim_pos β)) hd);
  let R :=
    PermutationRepresentation.isOrthogonalResolution_labelProj
      ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e));
  have hConst :=
    Eq.mpr
      (id
        (congrArg (fun _a => _a = (↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1)
          (Matrix.IsOrthogonalResolution.hom_apply R fun x => ↑↑r * ↑(Real.log ↑(Fintype.card C)))))
      (Eq.mpr (id (congrArg (fun _a => _a = (↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1) (Eq.symm Finset.smul_sum)))
        (Eq.mpr
          (id
            (congrArg (fun _a => (↑↑r * ↑(Real.log ↑(Fintype.card C))) • _a = (↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1)
              R.sum_eq))
          (Eq.refl ((↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1))));
  have hBad :=
    Eq.mpr (id (congrArg (fun _a => _a) (propext Matrix.le_iff)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              (_a -
                  PermutationRepresentation.labelEntropy
                    ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e))).PosSemidef)
            (Eq.symm hConst)))
        (Eq.mpr
          (id
            (congrArg (fun _a => ((R.hom fun x => ↑↑r * ↑(Real.log ↑(Fintype.card C))) - _a).PosSemidef)
              (PermutationRepresentation.labelEntropy.eq_1
                ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)))))
          (Eq.mpr
            (id
              (congrArg (fun _a => ((R.hom fun x => ↑↑r * ↑(Real.log ↑(Fintype.card C))) - _a).PosSemidef)
                (PermutationRepresentation.labelObservable_eq_hom
                  ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)) fun l => Real.log ↑l.dim)))
            (Eq.mpr
              (id
                (congrArg (fun _a => _a.PosSemidef)
                  (Eq.symm (map_sub R.hom (fun x => ↑↑r * ↑(Real.log ↑(Fintype.card C))) fun l => ↑(Real.log ↑l.dim)))))
              (id
                (Eq.mp
                  (congrArg Matrix.PosSemidef
                    (congrArg (⇑R.hom)
                      (funext fun i =>
                        Eq.trans (Complex.ofReal_sub (↑r * Real.log ↑(Fintype.card C)) (Real.log ↑i.dim))
                          (congrFun' (congrArg HSub.hSub (Complex.ofReal_mul (↑r) (Real.log ↑(Fintype.card C))))
                            ↑(Real.log ↑i.dim)))))
                  (Matrix.IsOrthogonalResolution.posSemidef_hom_of_ne_zero R
                    (fun β =>
                      PermutationRepresentation.isHermitian_labelProj
                        ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)) β)
                    fun β hβ => sub_nonneg.mpr (hLog β hβ))))))));
  ⟨hBad,
    have hWhole := (TensorPower.groupedCopies_labelEntropy_bounds e (TensorPower.copyPerm C k)).right;
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            PermutationRepresentation.labelEntropy (TensorPower.copyPerm C k) ≤
              PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) + _a)
          (add_smul (↑↑r * ↑(Real.log ↑(Fintype.card C))) (↑(Real.log ↑(k.choose r))) 1)))
      (Eq.mpr
        (id
          (congrArg (fun _a => PermutationRepresentation.labelEntropy (TensorPower.copyPerm C k) ≤ _a)
            (Eq.symm
              (add_assoc
                (PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)))
                ((↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1) (↑(Real.log ↑(k.choose r)) • 1)))))
        (LE.le.trans hWhole
          (Eq.mpr
            (id
              (Eq.trans TensorPower.copyPerm_groupedCopies_labelEntropy_bounds._simp_1_1
                (congrArg Matrix.PosSemidef
                  (Eq.trans
                    (add_sub_add_right_eq_sub
                      (PermutationRepresentation.labelEntropy
                          ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) +
                        (↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1)
                      (PermutationRepresentation.labelEntropy
                          ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) +
                        PermutationRepresentation.labelEntropy
                          ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)))
                      (↑(Real.log ↑(k.choose r)) • 1))
                    (add_sub_add_left_eq_sub ((↑↑r * ↑(Real.log ↑(Fintype.card C))) • 1)
                      (PermutationRepresentation.labelEntropy
                        ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₂ e)))
                      (PermutationRepresentation.labelEntropy
                        ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e))))))))
            (Eq.mp TensorPower.copyPerm_groupedCopies_labelEntropy_bounds._simp_1_1 hBad))))⟩
