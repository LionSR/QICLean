theorem TensorPower.copyPerm_groupedGood_labelEntropy_compression.{u_1} : ∀ {m r k : ℕ} (e : Fin m ⊕ Fin r ≃ Fin k)
  {C : Type u_1} [inst : Fintype C] [inst_1 : DecidableEq C] (l : IrrepLabel (Equiv.Perm (Fin k))),
  have P := PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l;
  have Fg := PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e));
  Commute Fg P ∧ ↑(Real.log ↑l.dim - ↑r * Real.log ↑(Fintype.card C) - Real.log ↑(k.choose r)) • P ≤ P * Fg * P :=
fun {m r k} e {C} [inst : Fintype C] [DecidableEq C] l =>
  id
    (have hc :=
      PermutationRepresentation.commute_labelObservable_of_forall_commute
        ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e))
        (fun σ =>
          Commute.symm
            (PermutationRepresentation.commute_labelProj_permOp (TensorPower.copyPerm C k) l
              ((TensorPower.groupHom₁ e) σ)))
        fun l => Real.log ↑l.dim;
    ⟨hc,
      have hWhole := (TensorPower.copyPerm_groupedCopies_labelEntropy_bounds e).right;
      have h :=
        Matrix.PosSemidef.conjTranspose_mul_mul_same (Matrix.le_iff.mp hWhole)
          (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l);
      Eq.mpr (id (congrArg (fun _a => _a) (propext Matrix.le_iff)))
        (Eq.mpr
          (eq_of_heq
            ((fun n R inst inst_2 inst_3 M M' e'_6 =>
                Eq.casesOn (motive := fun a x => M' = a → e'_6 ≍ x → M.PosSemidef ≍ M'.PosSemidef) e'_6
                  (fun h =>
                    Eq.ndrec (motive := fun M' => ∀ (e_6 : M = M'), e_6 ≍ Eq.refl M → M.PosSemidef ≍ M'.PosSemidef)
                      (fun e_6 h => HEq.refl M.PosSemidef) (Eq.symm h) e'_6)
                  (Eq.refl M') (HEq.refl e'_6))
              (Fin k → C) ℂ Complex.instRCLike.toDivisionRing.toRing RCLike.toPartialOrder Complex.instRCLike.toStarRing
              (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                    PermutationRepresentation.labelEntropy ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) *
                  PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l -
                ↑(Real.log ↑l.dim - ↑r * Real.log ↑(Fintype.card C) - Real.log ↑(k.choose r)) •
                  PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
              (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                    ((PermutationRepresentation.labelObservable
                        ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim) *
                      PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l) +
                  (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) •
                    PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l -
                ↑(Real.log ↑l.dim) • PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
              (Eq.mpr
                (id
                  (congr
                    (congrArg Eq
                      (congr
                        (congrArg HSub.hSub
                          (mul_assoc (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                            (PermutationRepresentation.labelObservable
                              ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim)
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                        (Eq.trans
                          (Eq.trans
                            (congrFun'
                              (congrArg HSMul.hSMul
                                (Eq.trans
                                  (Complex.ofReal_sub (Real.log ↑l.dim - ↑r * Real.log ↑(Fintype.card C))
                                    (Real.log ↑(k.choose r)))
                                  (congrFun'
                                    (congrArg HSub.hSub
                                      (Eq.trans (Complex.ofReal_sub (Real.log ↑l.dim) (↑r * Real.log ↑(Fintype.card C)))
                                        (congrArg (HSub.hSub ↑(Real.log ↑l.dim))
                                          (Complex.ofReal_mul (↑r) (Real.log ↑(Fintype.card C))))))
                                    ↑(Real.log ↑(k.choose r)))))
                              (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                            (sub_smul (↑(Real.log ↑l.dim) - ↑↑r * ↑(Real.log ↑(Fintype.card C)))
                              (↑(Real.log ↑(k.choose r)))
                              (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                          (congrFun'
                            (congrArg HSub.hSub
                              (sub_smul (↑(Real.log ↑l.dim)) (↑↑r * ↑(Real.log ↑(Fintype.card C)))
                                (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                            (↑(Real.log ↑(k.choose r)) •
                              PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))))
                    (congrFun'
                      (congrArg HSub.hSub
                        (congrArg
                          (HAdd.hAdd
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                              ((PermutationRepresentation.labelObservable
                                  ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l =>
                                  Real.log ↑l.dim) *
                                PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                          (add_smul (↑↑r * ↑(Real.log ↑(Fintype.card C))) (↑(Real.log ↑(k.choose r)))
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))))
                      (↑(Real.log ↑l.dim) • PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))))
                (TensorPower.copyPerm_groupedGood_labelEntropy_compression._abel_1_2 e l))))
          (Eq.mp
            (congrArg Matrix.PosSemidef
              (Eq.trans
                (Eq.trans
                  (congrFun'
                    (congrArg HMul.hMul
                      (Eq.trans
                        (Eq.trans
                          (congrFun'
                            (congrArg HMul.hMul
                              (Matrix.IsHermitian.eq
                                (PermutationRepresentation.isHermitian_labelProj (TensorPower.copyPerm C k) l)))
                            ((PermutationRepresentation.labelObservable
                                  ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l =>
                                  Real.log ↑l.dim) +
                                (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) • 1 -
                              PermutationRepresentation.labelObservable (TensorPower.copyPerm C k) fun l =>
                                Real.log ↑l.dim))
                          (mul_sub (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                            ((PermutationRepresentation.labelObservable
                                ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim) +
                              (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) • 1)
                            (PermutationRepresentation.labelObservable (TensorPower.copyPerm C k) fun l =>
                              Real.log ↑l.dim)))
                        (congrFun'
                          (congrArg HSub.hSub
                            (Eq.trans
                              (mul_add (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                                (PermutationRepresentation.labelObservable
                                  ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim)
                                ((↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) • 1))
                              (congrArg
                                (HAdd.hAdd
                                  (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                                    PermutationRepresentation.labelObservable
                                      ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l =>
                                      Real.log ↑l.dim))
                                (Eq.trans
                                  (mul_smul_comm (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r)))
                                    (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l) 1)
                                  (congrArg
                                    (HSMul.hSMul (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))))
                                    (mul_one (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))))))
                          (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                            PermutationRepresentation.labelObservable (TensorPower.copyPerm C k) fun l =>
                              Real.log ↑l.dim))))
                    (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                  (sub_mul
                    ((PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                        PermutationRepresentation.labelObservable
                          ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim) +
                      (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) •
                        PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                    (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                      PermutationRepresentation.labelObservable (TensorPower.copyPerm C k) fun l => Real.log ↑l.dim)
                    (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                (congr
                  (congrArg HSub.hSub
                    (Eq.trans
                      (add_mul
                        (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l *
                          PermutationRepresentation.labelObservable
                            ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim)
                        ((↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))) •
                          PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                        (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                      (congr
                        (congrArg HAdd.hAdd
                          (mul_assoc (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                            (PermutationRepresentation.labelObservable
                              ((TensorPower.copyPerm C k).comp (TensorPower.groupHom₁ e)) fun l => Real.log ↑l.dim)
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                        (Eq.trans
                          (smul_mul_assoc (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r)))
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                            (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                          (congrArg (HSMul.hSMul (↑↑r * ↑(Real.log ↑(Fintype.card C)) + ↑(Real.log ↑(k.choose r))))
                            (PermutationRepresentation.labelProj_mul_self (TensorPower.copyPerm C k) l))))))
                  (Eq.trans
                    (mul_assoc (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                      (PermutationRepresentation.labelObservable (TensorPower.copyPerm C k) fun l => Real.log ↑l.dim)
                      (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                    (Eq.trans
                      (Eq.trans
                        (congrArg (HMul.hMul (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l))
                          (PermutationRepresentation.labelObservable_mul_labelProj (TensorPower.copyPerm C k)
                            (fun l => Real.log ↑l.dim) l))
                        (mul_smul_comm (↑(Real.log ↑l.dim))
                          (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)
                          (PermutationRepresentation.labelProj (TensorPower.copyPerm C k) l)))
                      (congrArg (HSMul.hSMul ↑(Real.log ↑l.dim))
                        (PermutationRepresentation.labelProj_mul_self (TensorPower.copyPerm C k) l)))))))
            h))⟩)
