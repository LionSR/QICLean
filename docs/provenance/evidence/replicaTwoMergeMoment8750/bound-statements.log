            have DC := Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (TensorPower.pairMergeDeficit Q C m) 1;
            have DR := Matrix.kroneckerMap (fun x1 x2 => x1 * x2) 1 (TensorPower.pairMergeDeficit V R m);
            (ρ * NormedSpace.exp (↑a • (DC + DR))).trace.re ≤
              (↑((m + 1) ^ (Fintype.card Q * Fintype.card C) ^ 2) +
                    ↑((m + 1) ^ (Fintype.card V * Fintype.card R) ^ 2)) /
                  2 *
                ‖WithLp.toLp 2 w‖ ^ 2 :=
fun {Q} {Y} {V} {C} {R} [Fintype Q] [DecidableEq Q] [Fintype Y] [DecidableEq Y] [Fintype V] [DecidableEq V] [Fintype C]
    [DecidableEq C] [Fintype R] [DecidableEq R] Ω hΩ k B u hu a ha =>
  let m := Bᶜ.card;
  let ρ := Matrix.replicaGoodPairMarginal Ω k B u;
  let w := (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u;
  let DC := Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (TensorPower.pairMergeDeficit Q C m) 1;
  let DR := Matrix.kroneckerMap (fun x1 x2 => x1 * x2) 1 (TensorPower.pairMergeDeficit V R m);
  have hρ :=
    Matrix.PosSemidef.partialTraceRight
      (Matrix.posSemidef_vecMulVec_self_star fun x =>
        (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u
          ((FiniteProduct.splitEquiv (fun x => Q × Y × V) B).symm
              (x.2.2.1, fun i => (x.1.1.1 (Bᶜ.equivFin i), x.2.1 (Bᶜ.equivFin i), x.1.2.1 (Bᶜ.equivFin i))),
            (TensorPower.goodBadCopiesEquiv C B).symm (x.1.1.2, x.2.2.2.1),
            (TensorPower.goodBadCopiesEquiv R B).symm (x.1.2.2, x.2.2.2.2)));
  have hDC :=
    of_eq_true
      (Eq.trans
        (congrFun'
