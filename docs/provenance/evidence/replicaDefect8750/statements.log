Matrix.replicaHamiltonian.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (H : Matrix A A ℂ) (k : ℕ) :
  Matrix (Fin k → A) (Fin k → A) ℂ
Matrix.replicaDefectCount.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ) (k : ℕ) :
  Matrix (Fin k → A) (Fin k → A) ℂ
Matrix.replicaHamiltonian_mulVec_prod.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] {H : Matrix A A ℂ} {Ω : A → ℂ}
  {E₀ : ℂ} (hΩ : H.mulVec Ω = E₀ • Ω) (k : ℕ) :
  ((H.replicaHamiltonian k).mulVec fun x => ∏ i, Ω (x i)) = (↑k * E₀) • fun x => ∏ i, Ω (x i)
Matrix.replicaMeanHamiltonian_kronecker_mulVec_prod.{u_1, u_2} {A : Type u_1} [Fintype A] [DecidableEq A] {C : Type u_2}
  [Fintype C] [DecidableEq C] {H : Matrix A A ℂ} {Ω : A → ℂ} {E₀ : ℝ} (hΩ : H.mulVec Ω = ↑E₀ • Ω) {k : ℕ} (hk : 0 < k)
  (w : C → ℂ) :
  ((Matrix.kroneckerMap (fun x1 x2 => x1 * x2) ((↑k)⁻¹ • H.replicaHamiltonian k) 1).mulVec fun x =>
      (∏ i, Ω (x.1 i)) * w x.2) =
    ↑E₀ • fun x => (∏ i, Ω (x.1 i)) * w x.2
Matrix.PosSemidef.replica_gap.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] {H : Matrix A A ℂ} {Ω : A → ℂ} {E₀ g : ℝ}
  (hgap : (H - ↑E₀ • 1 - ↑g • (1 - Matrix.vecMulVec Ω (star Ω))).PosSemidef) (k : ℕ) :
  (H.replicaHamiltonian k - ↑(↑k * E₀) • 1 - ↑g • Matrix.replicaDefectCount Ω k).PosSemidef
Matrix.posSemidef_replicaDefectCount.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ)
  (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) : (Matrix.replicaDefectCount Ω k).PosSemidef
Matrix.spectralCutoff_replica_gap_mass_ge.{u_1, u_2} {A : Type u_1} [Fintype A] [DecidableEq A] {C : Type u_2}
  [Fintype C] [DecidableEq C] {H : Matrix A A ℂ} {Ω : A → ℂ} {E₀ g : ℝ}
  (hgap : (H - ↑E₀ • 1 - ↑g • (1 - Matrix.vecMulVec Ω (star Ω))).PosSemidef) (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (hg : 0 < g)
  {k : ℕ} (hk : 0 < k) {τ : ℝ} (hτ : 0 < τ) (v : EuclideanSpace ℂ ((Fin k → A) × C)) (hv : ‖v‖ = 1) :
  1 -
      ((star v.ofLp ⬝ᵥ
                (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) ((↑k)⁻¹ • H.replicaHamiltonian k) 1).mulVec v.ofLp).re -
            E₀) /
          g /
        τ ≤
    (star v.ofLp ⬝ᵥ
        (Matrix.kroneckerMap (fun x1 x2 => x1 * x2)
              (cfc (fun r => if r ≤ τ * ↑k then 1 else 0) (Matrix.replicaDefectCount Ω k)) 1).mulVec
          v.ofLp).re
Matrix.replicaExcitationProjection.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ) (k : ℕ)
  (B : Finset (Fin k)) : Matrix (Fin k → A) (Fin k → A) ℂ
Matrix.isStarProjection_replicaExcitationProjection.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ)
  (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) (B : Finset (Fin k)) :
  IsStarProjection (Matrix.replicaExcitationProjection Ω k B)
Matrix.sum_replicaExcitationProjection.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ) (k : ℕ) :
  ∑ B, Matrix.replicaExcitationProjection Ω k B = 1
Matrix.replicaDefectCount_mul_replicaExcitationProjection.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ)
  (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) (B : Finset (Fin k)) :
  Matrix.replicaDefectCount Ω k * Matrix.replicaExcitationProjection Ω k B =
    ↑B.card • Matrix.replicaExcitationProjection Ω k B
Matrix.cfc_replicaDefectCount_eq_sum_replicaExcitationProjection.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A]
  (Ω : A → ℂ) (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) (t : ℝ) :
  cfc (fun r => if r ≤ t then 1 else 0) (Matrix.replicaDefectCount Ω k) =
    ∑ B with ↑B.card ≤ t, Matrix.replicaExcitationProjection Ω k B
Matrix.replicaExcitationProjection_mul_of_ne.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] (Ω : A → ℂ)
  (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) {B C : Finset (Fin k)} (hBC : B ≠ C) :
  Matrix.replicaExcitationProjection Ω k B * Matrix.replicaExcitationProjection Ω k C = 0
Matrix.replicaDefectCutoff_decomposition.{u_1, u_2} {A : Type u_1} [Fintype A] [DecidableEq A] {C : Type u_2}
  [Fintype C] [DecidableEq C] (Ω : A → ℂ) (hΩ : ‖WithLp.toLp 2 Ω‖ = 1) (k : ℕ) (t : ℝ) (u : (Fin k → A) × C → ℂ)
  (hu :
    (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (cfc (fun r => if r ≤ t then 1 else 0) (Matrix.replicaDefectCount Ω k))
            1).mulVec
        u =
      u) :
  u =
      ∑ B with ↑B.card ≤ t,
        (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u ∧
    ∑ B,
        ‖WithLp.toLp 2
              ((Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec u)‖ ^
          2 =
      ‖WithLp.toLp 2 u‖ ^ 2
def Matrix.replicaHamiltonian.{u_1} : {A : Type u_1} →
  [Fintype A] → [DecidableEq A] → Matrix A A ℂ → (k : ℕ) → Matrix (Fin k → A) (Fin k → A) ℂ :=
fun {A} [Fintype A] [DecidableEq A] H k => ∑ i, Matrix.finKronecker fun j => if j = i then H else 1
def Matrix.replicaDefectCount.{u_1} : {A : Type u_1} →
  [Fintype A] → [DecidableEq A] → (A → ℂ) → (k : ℕ) → Matrix (Fin k → A) (Fin k → A) ℂ :=
fun {A} [Fintype A] [DecidableEq A] Ω k =>
  ∑ i, Matrix.finKronecker fun j => if j = i then 1 - Matrix.vecMulVec Ω (star Ω) else 1
def Matrix.replicaExcitationProjection.{u_1} : {A : Type u_1} →
  [Fintype A] → [DecidableEq A] → (A → ℂ) → (k : ℕ) → Finset (Fin k) → Matrix (Fin k → A) (Fin k → A) ℂ :=
fun {A} [Fintype A] [DecidableEq A] Ω k B =>
  Matrix.finKronecker fun j => if j ∈ B then 1 - Matrix.vecMulVec Ω (star Ω) else Matrix.vecMulVec Ω (star Ω)
