def TensorPower.goodBadCopiesEquiv.{u_1} : (C : Type u_1) →
  {k : ℕ} → (B : Finset (Fin k)) → (Fin k → C) ≃ (Fin Bᶜ.card → C) × (Fin B.card → C) :=
fun C {k} B => goodBadConfigEquiv✝ (replicaGoodBadSplit✝ B) C
def Matrix.replicaGoodAuxiliaryMarginal.{u_1, u_2, u_3} : {A : Type u_1} →
  {C : Type u_2} →
    {D : Type u_3} →
      [Fintype A] →
        [DecidableEq A] →
          [Fintype C] →
            [DecidableEq C] →
              [Fintype D] →
                [DecidableEq D] →
                  (A → ℂ) →
                    (k : ℕ) →
                      (B : Finset (Fin k)) →
                        ((Fin k → A) × (Fin k → C) × (Fin k → D) → ℂ) → Matrix (Fin Bᶜ.card → C) (Fin Bᶜ.card → C) ℂ :=
fun {A} {C} {D} [Fintype A] [DecidableEq A] [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D] Ω k B v =>
  have w := (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec v;
  have eAux :=
    ((TensorPower.goodBadCopiesEquiv C B).prodCongr (Equiv.refl (Fin k → D))).trans
      (Equiv.prodAssoc (Fin Bᶜ.card → C) (Fin B.card → C) (Fin k → D));
  ((Matrix.reindex eAux eAux) (Matrix.vecMulVec w (star w)).partialTraceLeft).partialTraceRight
theorem Matrix.commute_replicaGoodAuxiliaryMarginal_copyPerm.{u_1, u_2, u_3} : ∀ {A : Type u_1} {C : Type u_2}
  {D : Type u_3} [inst : Fintype A] [inst_1 : DecidableEq A] [inst_2 : Fintype C] [inst_3 : DecidableEq C]
  [inst_4 : Fintype D] [inst_5 : DecidableEq D] (Ω : A → ℂ) (k : ℕ) (B : Finset (Fin k))
  (v : (Fin k → A) × (Fin k → C) × (Fin k → D) → ℂ),
  (∀ (σ : Equiv.Perm (Fin k)),
      (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) ((PermutationRepresentation.permOp (TensorPower.copyPerm A k)) σ)
              (Matrix.kroneckerMap (fun x1 x2 => x1 * x2)
                ((PermutationRepresentation.permOp (TensorPower.copyPerm C k)) σ)
                ((PermutationRepresentation.permOp (TensorPower.copyPerm D k)) σ))).mulVec
          v =
        v) →
    ∀ (τ : Equiv.Perm (Fin Bᶜ.card)),
      Commute ((PermutationRepresentation.permOp (TensorPower.copyPerm C Bᶜ.card)) τ)
        (Matrix.replicaGoodAuxiliaryMarginal Ω k B v) :=
fun {A} {C} {D} [Fintype A] [DecidableEq A] [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D] Ω k B v hv τ =>
  let e := replicaGoodBadSplit✝ B;
  let σ := (TensorPower.groupHom₁ e) τ;
  let w := (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (Matrix.replicaExcitationProjection Ω k B) 1).mulVec v;
  have hw :=
    Matrix.replicaExcitationProjection_kronecker_mulVec_preserves_fixed Ω k B σ (good_group_image_eq✝ B τ)
      (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) ((PermutationRepresentation.permOp (TensorPower.copyPerm C k)) σ)
        ((PermutationRepresentation.permOp (TensorPower.copyPerm D k)) σ))
      v (hv σ);
  have hu :=
    Eq.mpr
      (id
        (congrArg
          (fun _a => _a.mulVec (w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm) = w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm)
          (Eq.symm (goodAuxiliaryRegroup_permOp✝ e A C D τ))))
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm)
            (Matrix.reindex_mulVec (goodAuxiliaryRegroup✝ e A C D)
              (Matrix.kroneckerMap (fun x1 x2 => x1 * x2)
                ((PermutationRepresentation.permOp (TensorPower.copyPerm A k)) ((TensorPower.groupHom₁ e) τ))
                (Matrix.kroneckerMap (fun x1 x2 => x1 * x2)
                  ((PermutationRepresentation.permOp (TensorPower.copyPerm C k)) ((TensorPower.groupHom₁ e) τ))
                  ((PermutationRepresentation.permOp (TensorPower.copyPerm D k)) ((TensorPower.groupHom₁ e) τ))))
              w)))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm = w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm)
              hw))
          (Eq.refl (w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm))));
  have h :=
    PermutationRepresentation.commute_partialTraceLeft_vecMulVec_of_fixed_kronecker_permOp
      (MonoidHom.fst (Equiv.Perm ((Fin k → A) × (Fin B.card → C) × (Fin k → D))) (Equiv.Perm (Fin Bᶜ.card → C)))
      (MonoidHom.snd (Equiv.Perm ((Fin k → A) × (Fin B.card → C) × (Fin k → D))) (Equiv.Perm (Fin Bᶜ.card → C)))
      (goodAuxiliaryDiscardPerm✝ e A C D τ, (TensorPower.copyPerm C Bᶜ.card) τ)
      (w ∘ ⇑(goodAuxiliaryRegroup✝ e A C D).symm) hu;
  Eq.mpr
    (id
      (congrArg (Commute (Equiv.Perm.permMatrix ℂ ((TensorPower.copyPerm C Bᶜ.card) τ)⁻¹))
        (Matrix.replicaGoodAuxiliaryMarginal_eq✝ Ω k B v)))
    h
