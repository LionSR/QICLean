{
  "environment": "source ${WORKSPACE}/glm23-blueprint-env.sh",
  "working_directory": "${WORKSPACE}/8766-unitary-evolution-focused/blueprint/src",
  "commands": [
    {
      "working_directory": "${WORKSPACE}",
      "command": "python ${WORKSPACE}/prepare-unitary-evolution-render.py",
      "exit_code": 0
    },
    {
      "command": "export XDG_CACHE_HOME=${WORKSPACE}/8766-unitary-evolution-focused/font-cache && latexmk -xelatex -interaction=nonstopmode -halt-on-error print.tex > ../../pdf-build.log 2>&1",
      "exit_code": 0
    },
    {
      "command": "cp print.bbl web.bbl && plastex -c plastex.cfg web.tex > ../../web-build.log 2>&1",
      "exit_code": 0
    },
    {
      "working_directory": "${WORKSPACE}/8766-unitary-evolution-focused",
      "command": "mkdir -p pdf-pages && pdftoppm -scale-to 1500 -png blueprint/src/print.pdf pdf-pages/page > pdf-raster.log 2>&1 && pdfinfo blueprint/src/print.pdf > pdf-info.txt",
      "exit_code": 0
    },
    {
      "command": "python ${WORKSPACE}/verify-unitary-evolution-render.py",
      "exit_code": 0
    },
    {
      "working_directory": "${WORKSPACE}/8766-unitary-evolution-focused",
      "command": "export XDG_CACHE_HOME=${WORKSPACE}/8766-unitary-evolution-focused/font-cache && dot -Gbgcolor=white -Tpng dependency-graph.dot -o dependency-graph-white.png",
      "exit_code": 0
    }
  ],
