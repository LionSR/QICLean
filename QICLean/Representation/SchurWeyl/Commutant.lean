import QICLean.Representation.TensorPower.SiteOperators

import Mathlib.RingTheory.MvPolynomial.Symmetric.NewtonIdentities
import QICLean.Analysis.Norm.RootChannel
import QICLean.Analysis.Norm.L2OpNormReindex

/-!
# The commutant of the copy permutations is generated by the diagonal action

Let `ℂ^Ω` be a finite-dimensional space and `(ℂ^Ω)^{⊗k}` its `k`-th tensor power, with
basis indexed by `Fin k → Ω`. For a matrix `A` on `ℂ^Ω` write `A^{(j)}` for `A` acting on
the `j`-th copy, and `Δ(A) = ∑_j A^{(j)}` for the diagonal (Lie-algebra) action. This file
proves the half of Schur–Weyl duality used for the Schur-label estimates of the area-law
paper (*A two-dimensional area law from a global spectral gap*, `05-replicas.tex`,
lines 46–64; the paper cites Etingof et al., Theorem 5.18.4): **every operator commuting
with the copy permutations lies in the algebra generated by the operators `Δ(A)`**.

## Method

* By Newton's identities, `A^{⊗k} = A^{(1)} ⋯ A^{(k)}`, the top elementary symmetric
  polynomial of the commuting family `A^{(j)}`, is a polynomial in the power sums
  `∑_j (A^{(j)})^m = Δ(A^m)`.
* By polarization, the symmetrization `∑_σ B_{σ 1} ⊗ ⋯ ⊗ B_{σ k}` equals
  `∑_{S} (-1)^{k - |S|} (∑_{i ∈ S} B_i)^{⊗k}`.
* An operator commuting with the copy permutations is the average of its conjugates, a
  combination of symmetrizations of elementary tensors of matrix units.

## Main declarations

* `TensorPower.partialTensor`, `TensorPower.siteOp`, `TensorPower.tensorPow`,
  `TensorPower.diagOp` — the operators `⊗_{j ∈ s} A_j`, `A^{(j)}`, `A^{⊗k}`, `Δ(A)`, in
  `QICLean.Representation.TensorPower.SiteOperators`.
* `TensorPower.diagAlgebra` — the algebra generated by the operators `Δ(A)`.
* `TensorPower.tensorPow_mem_diagAlgebra` — `A^{⊗k}` lies in it.
* `TensorPower.commutant_le_diagAlgebra` — **Schur–Weyl**: the commutant of the copy
  permutations lies in it.
-/

open Finset Matrix PermutationRepresentation
open scoped IsMulCommutative

namespace TensorPower

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω] {k : ℕ}

variable (Ω k) in
/-- The algebra generated by the diagonal action. -/
noncomputable def diagAlgebra : Subalgebra ℂ (Matrix (Fin k → Ω) (Fin k → Ω) ℂ) :=
  Algebra.adjoin ℂ (Set.range (diagOp (Ω := Ω) (k := k)))

theorem diagOp_mem_diagAlgebra (A : Matrix Ω Ω ℂ) : diagOp (k := k) A ∈ diagAlgebra Ω k :=
  Algebra.subset_adjoin ⟨A, rfl⟩


/-! ### Newton's identities: tensor powers lie in the diagonal algebra -/

/-- By Newton's identities, every elementary symmetric polynomial lies in the subalgebra
generated by the power sums (over `ℂ`). -/
theorem _root_.MvPolynomial.esymm_mem_adjoin_psum (σ : Type*) [Fintype σ] (n : ℕ) :
    MvPolynomial.esymm σ ℂ n ∈ Algebra.adjoin ℂ (Set.range (MvPolynomial.psum σ ℂ)) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [MvPolynomial.esymm_zero]
    exact one_mem _
  set S := Algebra.adjoin ℂ (Set.range (MvPolynomial.psum σ ℂ))
  have hmem : (n : MvPolynomial σ ℂ) * MvPolynomial.esymm σ ℂ n ∈ S := by
    rw [MvPolynomial.mul_esymm_eq_sum]
    refine mul_mem (pow_mem (neg_mem (one_mem _)) _) (sum_mem fun a ha => ?_)
    exact mul_mem (mul_mem (pow_mem (neg_mem (one_mem _)) _)
      (ih a.1 (mem_filter.mp ha).2)) (Algebra.subset_adjoin ⟨a.2, rfl⟩)
  have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  have heq : MvPolynomial.esymm σ ℂ n =
      (n : ℂ)⁻¹ • ((n : MvPolynomial σ ℂ) * MvPolynomial.esymm σ ℂ n) := by
    rw [show (n : MvPolynomial σ ℂ) = algebraMap ℂ _ (n : ℂ) by simp, ← Algebra.smul_def,
      smul_smul, inv_mul_cancel₀ hn', one_smul]
  rw [heq]
  exact S.smul_mem hmem _

/-- `A^{⊗k}` lies in the algebra generated by the diagonal action. -/
theorem tensorPow_mem_diagAlgebra (A : Matrix Ω Ω ℂ) : tensorPow A ∈ diagAlgebra Ω k := by
  have hcomm : (Set.range fun j : Fin k => siteOp j A).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
    exact commute_siteOp i j A
  have := Algebra.isMulCommutative_adjoin ℂ hcomm
  set C := Algebra.adjoin ℂ (Set.range fun j : Fin k => siteOp j A)
  let c : Fin k → C := fun j => ⟨siteOp j A, Algebra.subset_adjoin ⟨j, rfl⟩⟩
  let ψ : MvPolynomial (Fin k) ℂ →ₐ[ℂ] Matrix (Fin k → Ω) (Fin k → Ω) ℂ :=
    C.val.comp (MvPolynomial.aeval c)
  have hprod : ∀ s : Finset (Fin k),
      ((∏ j ∈ s, c j : C) : Matrix (Fin k → Ω) (Fin k → Ω) ℂ) =
        partialTensor s fun _ => A := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
      rw [prod_insert hj, Subalgebra.coe_mul, ih]
      change partialTensor {j} (fun _ => A) * _ = _
      rw [partialTensor_mul_partialTensor (disjoint_singleton_left.mpr hj), singleton_union]
      exact partialTensor_congr fun i _ => by split_ifs <;> rfl
  have hψe : ψ (MvPolynomial.esymm (Fin k) ℂ k) = tensorPow A := by
    have h : powersetCard k (univ : Finset (Fin k)) = {univ} := by
      simpa using powersetCard_self (univ : Finset (Fin k))
    rw [MvPolynomial.esymm, h, sum_singleton]
    change ((MvPolynomial.aeval c (∏ j, MvPolynomial.X j) : C) :
      Matrix (Fin k → Ω) (Fin k → Ω) ℂ) = _
    rw [map_prod]
    simp only [MvPolynomial.aeval_X]
    exact hprod univ
  have hψp : ∀ m, ψ (MvPolynomial.psum (Fin k) ℂ m) = diagOp (A ^ m) := by
    intro m
    simp [ψ, c, MvPolynomial.psum, diagOp, siteOp_pow]
  rw [← hψe]
  have h1 := MvPolynomial.esymm_mem_adjoin_psum (Fin k) k
  have h2 : (Algebra.adjoin ℂ (Set.range (MvPolynomial.psum (Fin k) ℂ))).map ψ ≤
      diagAlgebra Ω k := by
    rw [AlgHom.map_adjoin]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
    rw [hψp]
    exact diagOp_mem_diagAlgebra _
  exact h2 ⟨_, h1, rfl⟩

/-! ### Polarization -/

/-- The symmetrization `∑_σ B_{σ 1} ⊗ ⋯ ⊗ B_{σ k}`. -/
def symTensor (B : Fin k → Matrix Ω Ω ℂ) : Matrix (Fin k → Ω) (Fin k → Ω) ℂ :=
  ∑ σ : Equiv.Perm (Fin k), partialTensor univ (B ∘ σ)

/-- Inclusion–exclusion over the supersets of `T`. -/
theorem sum_superset_neg_one_pow (T : Finset (Fin k)) :
    ∑ S ∈ univ.filter (T ⊆ ·), (-1 : ℂ) ^ #Sᶜ = if T = univ then 1 else 0 := by
  have h : ∑ S ∈ univ.filter (T ⊆ ·), (-1 : ℂ) ^ #Sᶜ = ∑ U ∈ Tᶜ.powerset, (-1 : ℂ) ^ #U := by
    refine sum_nbij' (fun S => Sᶜ) (fun U => Uᶜ) ?_ ?_ ?_ ?_ ?_
    · intro S hS
      simpa [compl_subset_compl] using (mem_filter.mp hS).2
    · intro U hU
      simp only [mem_filter, mem_univ, true_and]
      intro x hx
      rw [mem_compl]
      intro hxU
      exact mem_compl.mp (mem_powerset.mp hU hxU) hx
    · intro S _; simp
    · intro U _; simp
    · intro S _; rfl
  rw [h]
  have := congrArg (fun z : ℤ => (z : ℂ)) (sum_powerset_neg_one_pow_card (x := Tᶜ))
  simp only [Int.cast_sum, Int.cast_pow, Int.cast_neg, Int.cast_one] at this
  rw [this]
  by_cases hT : T = univ
  · simp [hT]
  · simp [hT, compl_eq_empty_iff]

/-- Summing over the maps `Fin k → Fin k` with full image is summing over permutations. -/
theorem sum_image_eq_univ_eq_sum_perm (g : (Fin k → Fin k) → ℂ) :
    ∑ f, (if univ.image f = univ then g f else 0) = ∑ σ : Equiv.Perm (Fin k), g σ := by
  rw [← sum_filter]
  have h : univ.filter (fun f : Fin k → Fin k => univ.image f = univ) =
      univ.map ⟨fun σ : Equiv.Perm (Fin k) => ⇑σ, DFunLike.coe_injective⟩ := by
    ext f
    simp only [mem_filter, mem_univ, true_and, mem_map, Function.Embedding.coeFn_mk]
    constructor
    · intro hf
      have hs : Function.Surjective f := fun b => by
        have : b ∈ univ.image f := by rw [hf]; exact mem_univ b
        simpa using this
      exact ⟨Equiv.ofBijective f ⟨Finite.injective_iff_surjective.mpr hs, hs⟩, rfl⟩
    · rintro ⟨σ, rfl⟩
      exact eq_univ_of_forall fun b => mem_image.mpr ⟨σ.symm b, mem_univ _, by simp⟩
  rw [h, sum_map]
  rfl

omit [Fintype Ω] in
theorem tensorPow_sum (S : Finset (Fin k)) (B : Fin k → Matrix Ω Ω ℂ) :
    tensorPow (k := k) (∑ i ∈ S, B i) =
      ∑ f ∈ Fintype.piFinset fun _ => S, partialTensor univ (B ∘ f) := by
  ext x y
  simp only [tensorPow, partialTensor_univ_apply, Matrix.sum_apply, Function.comp_apply]
  exact prod_univ_sum (fun _ => S) fun j i => B i (x j) (y j)

omit [Fintype Ω] in
/-- **Polarization.** `∑_σ ⊗_j B_{σ j} = ∑_S (-1)^{k - |S|} (∑_{i ∈ S} B_i)^{⊗k}`. -/
theorem symTensor_eq_sum (B : Fin k → Matrix Ω Ω ℂ) :
    symTensor B = ∑ S : Finset (Fin k), ((-1 : ℂ) ^ #Sᶜ) • tensorPow (k := k) (∑ i ∈ S, B i) := by
  simp_rw [tensorPow_sum, smul_sum]
  ext x y
  simp only [symTensor, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
  set P : (Fin k → Fin k) → ℂ := fun f => partialTensor univ (B ∘ f) x y
  change ∑ σ : Equiv.Perm (Fin k), P σ = ∑ S, ∑ f ∈ Fintype.piFinset fun _ => S, (-1) ^ #Sᶜ * P f
  rw [← sum_image_eq_univ_eq_sum_perm]
  have : ∀ S : Finset (Fin k), ∑ f ∈ Fintype.piFinset (fun _ => S), (-1 : ℂ) ^ #Sᶜ * P f =
      ∑ f, if univ.image f ⊆ S then (-1) ^ #Sᶜ * P f else 0 := by
    intro S
    rw [← sum_filter]
    congr 1
    ext f
    simp [image_subset_iff]
  simp_rw [this]
  rw [sum_comm]
  refine sum_congr rfl fun f _ => ?_
  rw [← sum_filter, ← sum_mul, show univ.filter (fun S : Finset (Fin k) => univ.image f ⊆ S) =
    univ.filter (univ.image f ⊆ ·) from rfl, sum_superset_neg_one_pow]
  split_ifs <;> simp

theorem symTensor_mem_diagAlgebra (B : Fin k → Matrix Ω Ω ℂ) :
    symTensor B ∈ diagAlgebra Ω k := by
  rw [symTensor_eq_sum]
  exact sum_mem fun S _ => Subalgebra.smul_mem _ (tensorPow_mem_diagAlgebra _) _

/-! ### The commutant -/

/-- An operator commuting with the copy permutations is the average of its conjugates. -/
theorem eq_smul_sum_symTensor_of_mem_commutant {M : Matrix (Fin k → Ω) (Fin k → Ω) ℂ}
    (hM : M ∈ commutant (copyPerm Ω k)) :
    M = ((k.factorial : ℂ)⁻¹) •
      ∑ x, ∑ y, M x y • symTensor (fun j => Matrix.single (x j) (y j) (1 : ℂ)) := by
  ext z w
  simp only [Matrix.smul_apply, Matrix.sum_apply, symTensor, smul_eq_mul,
    partialTensor_univ_apply, Function.comp_apply, Matrix.single_apply, mul_sum]
  simp only [Fintype.prod_ite_zero, prod_const_one]
  have key : ∀ σ : Equiv.Perm (Fin k), (∑ x, ∑ y, (k.factorial : ℂ)⁻¹ *
      (M x y * if ∀ i, x (σ i) = z i ∧ y (σ i) = w i then 1 else 0)) =
        (k.factorial : ℂ)⁻¹ * M z w := by
    intro σ
    rw [sum_eq_single (fun j => z (σ.symm j)), sum_eq_single (fun j => w (σ.symm j))]
    · rw [ite_eq_left (by simp), mul_one]
      have := apply_eq_of_mem_commutant (copyPerm Ω k) hM σ z w
      exact congrArg _ this
    · intro y _ hy
      rw [ite_eq_right, mul_zero, mul_zero]
      intro h
      apply hy
      funext j
      simpa using (h (σ.symm j)).2
    · simp
    · intro x _ hx
      refine sum_eq_zero fun y _ => ?_
      rw [ite_eq_right, mul_zero, mul_zero]
      intro h
      apply hx
      funext j
      simpa using (h (σ.symm j)).1
    · simp
  have hk : (k.factorial : ℂ) ≠ 0 := by exact_mod_cast k.factorial_ne_zero
  calc M z w = ∑ σ : Equiv.Perm (Fin k), (k.factorial : ℂ)⁻¹ * M z w := by
        rw [sum_const, card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul,
          ← mul_assoc, mul_inv_cancel₀ hk, one_mul]
    _ = _ := sum_congr rfl fun σ _ => (key σ).symm
    _ = _ := sum_comm
    _ = _ := sum_congr rfl fun x _ => sum_comm

/-- **Schur–Weyl duality** (`05-replicas.tex`, lines 46–64; Etingof et al.,
Theorem 5.18.4): every operator on `(ℂ^Ω)^{⊗k}` commuting with the copy permutations lies in
the algebra generated by the diagonal action. -/
theorem commutant_le_diagAlgebra :
    commutant (copyPerm Ω k) ≤ Subalgebra.toSubmodule (diagAlgebra Ω k) := by
  intro M hM
  rw [eq_smul_sum_symTensor_of_mem_commutant hM]
  exact Submodule.smul_mem _ _ (Submodule.sum_mem _ fun x _ => Submodule.sum_mem _ fun y _ =>
    Submodule.smul_mem _ _ (symTensor_mem_diagAlgebra _))

section Generic

open scoped Kronecker Matrix.Norms.L2Operator

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω] {k : ℕ}

omit [Fintype Ω] in
/-- `h^{(j)}` is `h ⊗ 1` after splitting off the copy `j`. -/
theorem siteOp_eq_reindex (j : Fin k) (A : Matrix Ω Ω ℂ) :
    siteOp j A = reindex (Equiv.piSplitAt j fun _ => Ω).symm (Equiv.piSplitAt j fun _ => Ω).symm
      (A ⊗ₖ (1 : Matrix ({i // i ≠ j} → Ω) ({i // i ≠ j} → Ω) ℂ)) := by
  ext x y
  simp only [siteOp_apply, reindex_apply, submatrix_apply, Equiv.symm_symm, kroneckerMap_apply,
    one_apply]
  simp only [Equiv.piSplitAt, Equiv.coe_fn_mk]
  by_cases hc : ∀ i, i ≠ j → x i = y i
  · have hf : (fun i : {i // i ≠ j} => x i) = fun i : {i // i ≠ j} => y i :=
      funext fun i => hc i.1 i.2
    rw [ite_eq_left hc, ite_eq_left hf, mul_one]
  · rw [ite_eq_right hc, ite_eq_right, mul_zero]
    intro h'
    exact hc fun i hi => congrFun h' ⟨i, hi⟩

/-- `‖h^{(j)}‖ ≤ ‖h‖` in the operator norm, uniformly in the number of copies. -/
theorem l2_opNorm_siteOp_le (j : Fin k) (A : Matrix Ω Ω ℂ) : ‖siteOp j A‖ ≤ ‖A‖ := by
  rw [siteOp_eq_reindex, l2_opNorm_reindex_equiv]
  exact l2_opNorm_kronecker_one_le A

omit [Fintype Ω] in
theorem siteOp_sum {ι : Type*} (s : Finset ι) (j : Fin k) (A : ι → Matrix Ω Ω ℂ) :
    siteOp j (∑ i ∈ s, A i) = ∑ i ∈ s, siteOp j (A i) := by
  ext x y
  simp only [siteOp_apply, Matrix.sum_apply]
  split_ifs <;> simp

omit [Fintype Ω] in
theorem conjTranspose_siteOp (j : Fin k) (A : Matrix Ω Ω ℂ) : (siteOp j A)ᴴ = siteOp j Aᴴ := by
  ext x y
  simp only [conjTranspose_apply, siteOp_apply]
  by_cases hc : ∀ i, i ≠ j → y i = x i
  · rw [ite_eq_left hc, ite_eq_left fun i hi => (hc i hi).symm]
  · rw [ite_eq_right hc, ite_eq_right fun h' => hc fun i hi => (h' i hi).symm, star_zero]

end Generic

end TensorPower
