/-!
# The word algebra of a finite alphabet

This file introduces the free unital associative algebra `F = ℂ⟨x_1, …, x_d⟩`, realized as the
monoid algebra of the free monoid on `Fin d`, so that the words are a basis, together with its
augmentation ideal `F₊` of polynomials without constant term and the trace characters of its
finite-dimensional modules (TNLean note on asymmetric compressions, §7.4, eq:p5-free-algebra and
eq:p5-positive-ideal).

A finite-dimensional module `M` over the word algebra is *nilpotent* when the trace of every
nonempty word on `M` vanishes. Then every word of length at least `dim M` acts as zero;
conversely, if all words of some length act as zero, the module is nilpotent.

## Main definitions

* `WordAlgebra d`: the monoid algebra `MonoidAlgebra ℂ (FreeMonoid (Fin d))`.
* `WordAlgebra.ofWord w`: the basis element of the word `w : List (Fin d)`.
* `WordAlgebra.aug`: the augmentation, the algebra map sending every generator to `0`; its kernel
  is the two-sided ideal `F₊` of polynomials without constant term.
* `WordAlgebra.traceChar M`: the trace character of a module `M`, the trace of Mathlib's
  action `Algebra.lsmul ℂ ℂ M` of the word algebra by `ℂ`-linear endomorphisms, together
  with the word traces `WordAlgebra.traceWord M w`.

The type is Mathlib's `MonoidAlgebra` of the free monoid rather than `FreeAlgebra ℂ (Fin d)`
(the two are identified by `FreeAlgebra.equivMonoidAlgebraFreeMonoid`): the module generated by
a representation of the free monoid is Mathlib's `Representation.asModule`, which is a module over
exactly this monoid algebra, and the words are literally its basis.

Moved from TNLean, `TNLean/Algebra/WordAlgebra.lean` and `TNLean/Algebra/WordAlgebraNilpotent.lean`
at commit `49b78ed821` (Apache-2.0). Changes: the two files are merged.

## Main results

* `WordAlgebra.linearMap_eq_on_ker_aug`: two linear functionals agreeing on every nonempty
  word agree on the kernel of the augmentation.
* `WordAlgebra.smul_eq_aug_smul`: when every generator acts as zero, the word algebra acts
  through the augmentation.
* `WordAlgebra.finrank_eq_one_of_isSimpleModule_of_forall_smul_eq_zero`: a simple module on
  which every generator acts as zero is one-dimensional.
* `WordAlgebra.ofWord_smul_eq_zero_of_traceWord_eq_zero`: on a module where every nonempty word
  has trace zero, every word of length at least the dimension acts as zero.
* `WordAlgebra.traceWord_eq_zero_of_forall_ofWord_smul_eq_zero`: conversely, if all words of
  some length act as zero, every nonempty word has trace zero.

Moved from TNLean, `TNLean/MPS/FundamentalTheorem/WordModule/SimpleSeparation.lean`,
`TNLean/MPS/FundamentalTheorem/WordModule/StarSemisimple.lean`,
`TNLean/MPS/FundamentalTheorem/WordModule/Flag.lean`,
`TNLean/MPS/FundamentalTheorem/Compression/LabelledFlag.lean`,
`TNLean/MPS/FundamentalTheorem/Arbitrary/Basic.lean` at commit `021ba0bd19` (Apache-2.0).
-/

/-- The word algebra on the alphabet `Fin d`: the monoid algebra of the free monoid, i.e. the
free unital associative `ℂ`-algebra on `d` generators with the words as a basis. -/
abbrev WordAlgebra (d : ℕ) := MonoidAlgebra ℂ (FreeMonoid (Fin d))

namespace WordAlgebra

variable {d : ℕ}

/-- The basis element of the word `w`. -/
noncomputable def ofWord (w : List (Fin d)) : WordAlgebra d :=
  MonoidAlgebra.of ℂ (FreeMonoid (Fin d)) (FreeMonoid.ofList w)

@[simp] lemma ofWord_nil : ofWord ([] : List (Fin d)) = 1 :=
  map_one (MonoidAlgebra.of ℂ (FreeMonoid (Fin d)))

lemma ofWord_append (u v : List (Fin d)) : ofWord (u ++ v) = ofWord u * ofWord v := by
  simp [ofWord, FreeMonoid.ofList_append]

lemma ofWord_cons (i : Fin d) (w : List (Fin d)) : ofWord (i :: w) = ofWord [i] * ofWord w := by
  rw [← ofWord_append]; rfl

/-- The augmentation: the algebra map sending every generator to zero. Its kernel is the ideal
of polynomials with zero constant term. -/
noncomputable def aug : WordAlgebra d →ₐ[ℂ] ℂ :=
  MonoidAlgebra.lift ℂ ℂ (FreeMonoid (Fin d)) (FreeMonoid.lift fun _ => (0 : ℂ))

lemma aug_ofWord (w : List (Fin d)) : aug (ofWord w) = if w = [] then 1 else 0 := by
  unfold aug ofWord
  rw [MonoidAlgebra.lift_of, FreeMonoid.lift_apply, FreeMonoid.toList_ofList]
  cases w with
  | nil => simp
  | cons i w => simp

@[simp] lemma aug_ofWord_nil : aug (ofWord ([] : List (Fin d))) = 1 := by simp

lemma aug_mul_left {p : WordAlgebra d} (hp : aug p = 0) (q : WordAlgebra d) :
    aug (q * p) = 0 := by
  rw [map_mul, hp, mul_zero]

lemma aug_mul_right {p : WordAlgebra d} (hp : aug p = 0) (q : WordAlgebra d) :
    aug (p * q) = 0 := by
  rw [map_mul, hp, zero_mul]

lemma aug_pow {p : WordAlgebra d} (hp : aug p = 0) {n : ℕ} (hn : 0 < n) : aug (p ^ n) = 0 := by
  rw [map_pow, hp, zero_pow hn.ne']

/-- A linear functional is determined on the kernel of the augmentation by its values on the
nonempty words: the difference of two functionals agreeing there is a multiple of the
augmentation. -/
lemma sub_eq_aug_mul {χ₁ χ₂ : WordAlgebra d →ₗ[ℂ] ℂ}
    (h : ∀ w : List (Fin d), w ≠ [] → χ₁ (ofWord w) = χ₂ (ofWord w)) (p : WordAlgebra d) :
    χ₁ p - χ₂ p = (χ₁ 1 - χ₂ 1) * aug p := by
  induction p using MonoidAlgebra.induction_on with
  | of g =>
    change χ₁ (ofWord (FreeMonoid.toList g)) - χ₂ (ofWord (FreeMonoid.toList g)) =
      (χ₁ 1 - χ₂ 1) * aug (ofWord (FreeMonoid.toList g))
    rw [aug_ofWord]
    split_ifs with hw
    · rw [hw]; simp
    · rw [h _ hw]; simp
  | add f g hf hg => rw [map_add, map_add, map_add, mul_add, ← hf, ← hg]; ring
  | smul r f hf =>
    rw [map_smul, map_smul, map_smul, smul_eq_mul, smul_eq_mul, smul_eq_mul, ← mul_assoc,
      mul_comm _ r, mul_assoc, ← hf]
    ring

/-- Two linear functionals agreeing on every nonempty word agree on the kernel of the
augmentation. -/
lemma linearMap_eq_on_ker_aug {χ₁ χ₂ : WordAlgebra d →ₗ[ℂ] ℂ}
    (h : ∀ w : List (Fin d), w ≠ [] → χ₁ (ofWord w) = χ₂ (ofWord w)) {p : WordAlgebra d}
    (hp : aug p = 0) : χ₁ p = χ₂ p := by
  have := sub_eq_aug_mul h p
  rw [hp, mul_zero, sub_eq_zero] at this
  exact this

section Module

variable (M : Type*) [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M]

/-- The trace character `p ↦ tr (ρ_M p)` of the module `M`, where `ρ_M = Algebra.lsmul ℂ ℂ M`
is the action of the word algebra by `ℂ`-linear endomorphisms. -/
noncomputable def traceChar : WordAlgebra d →ₗ[ℂ] ℂ :=
  (LinearMap.trace ℂ M).comp (Algebra.lsmul ℂ ℂ M).toLinearMap

lemma traceChar_apply (p : WordAlgebra d) :
    traceChar M p = LinearMap.trace ℂ M (Algebra.lsmul ℂ ℂ M p) := rfl

/-- The trace of the action of the word `w`. -/
noncomputable def traceWord (w : List (Fin d)) : ℂ := traceChar M (ofWord w)

lemma traceWord_def (w : List (Fin d)) :
    traceWord M w = LinearMap.trace ℂ M (Algebra.lsmul ℂ ℂ M (ofWord w : WordAlgebra d)) := rfl

variable {M}

/-- If every generator acts as zero on `M`, the word algebra acts through the augmentation. -/
lemma smul_eq_aug_smul (h0 : ∀ (i : Fin d) (m : M), (ofWord [i] : WordAlgebra d) • m = 0)
    (p : WordAlgebra d) (m : M) : p • m = aug p • m := by
  have key : (Algebra.lsmul ℂ ℂ M : WordAlgebra d →ₐ[ℂ] Module.End ℂ M) =
      (Algebra.ofId ℂ (Module.End ℂ M)).comp aug := by
    refine MonoidAlgebra.algHom_ext ?_ (Subsingleton.elim _ _)
    intro g
    change Algebra.lsmul ℂ ℂ M (ofWord (FreeMonoid.toList g) : WordAlgebra d) =
      (Algebra.ofId ℂ (Module.End ℂ M)) (aug (ofWord (FreeMonoid.toList g)))
    rw [aug_ofWord]
    generalize FreeMonoid.toList g = w
    cases w with
    | nil => simp
    | cons i w =>
      simp only [reduceCtorEq, ite_false, map_zero]
      ext m
      rw [ofWord_cons, map_mul, Module.End.mul_apply, Algebra.lsmul_apply, Algebra.lsmul_apply, h0]
      simp
  have := congrArg (fun f : WordAlgebra d →ₐ[ℂ] Module.End ℂ M => f p m) key
  simpa [Algebra.ofId_apply] using this

/-- A simple module on which every generator acts as zero is one-dimensional over `ℂ`: it is
the one-dimensional zero module (Lemma 7.5 of the TNLean note on asymmetric compressions, final
paragraph). -/
lemma finrank_eq_one_of_isSimpleModule_of_forall_smul_eq_zero
    [IsSimpleModule (WordAlgebra d) M]
    (h0 : ∀ (i : Fin d) (m : M), (ofWord [i] : WordAlgebra d) • m = 0) :
    Module.finrank ℂ M = 1 := by
  rw [← isSimpleModule_iff_finrank_eq_one, isSimpleModule_iff]
  let e : Submodule (WordAlgebra d) M ≃o Submodule ℂ M :=
    { toFun := Submodule.restrictScalars ℂ
      invFun := fun N =>
        { carrier := N
          add_mem' := fun ha hb => N.add_mem ha hb
          zero_mem' := N.zero_mem
          smul_mem' := fun p m hm => by
            change p • m ∈ N
            rw [smul_eq_aug_smul h0]
            exact N.smul_mem _ hm }
      left_inv := fun K => by ext; rfl
      right_inv := fun N => by ext; rfl
      map_rel_iff' := fun {K₁ K₂} => Submodule.restrictScalars_le ℂ }
  have : Nontrivial (Submodule ℂ M) := e.symm.toEquiv.nontrivial
  refine ⟨fun N => ?_⟩
  rcases IsSimpleOrder.eq_bot_or_eq_top (e.symm N) with hN | hN
  · left
    simpa using congrArg e hN
  · right
    simpa using congrArg e hN

end Module

end WordAlgebra

/-! ### Nilpotent modules -/

namespace WordAlgebra

variable {d : ℕ} {M : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [FiniteDimensional ℂ M]

omit [Module ℂ M] [IsScalarTower ℂ (WordAlgebra d) M] [FiniteDimensional ℂ M] in
/-- If every word of length `n` acts as zero, so does every longer word: split off the prefix
of length `n`. -/
private theorem ofWord_smul_eq_zero_of_length_le {n : ℕ}
    (h : ∀ w : List (Fin d), w.length = n → ∀ m : M, (ofWord w : WordAlgebra d) • m = 0)
    {u : List (Fin d)} (hu : n ≤ u.length) (m : M) : (ofWord u : WordAlgebra d) • m = 0 := by
  rw [← u.take_append_drop n, ofWord_append, mul_smul]
  exact h _ (by simp [List.length_take, Nat.min_eq_left hu]) _

/-- The `k`-th power of a word is a word of length `k |w|`. -/
private theorem exists_ofWord_pow_eq (w : List (Fin d)) (k : ℕ) :
    ∃ u : List (Fin d), u.length = k * w.length ∧ (ofWord w : WordAlgebra d) ^ k = ofWord u := by
  induction k with
  | zero => exact ⟨[], by simp, by simp⟩
  | succ k ih =>
    obtain ⟨u, hu, hpow⟩ := ih
    exact ⟨u ++ w, by simp [hu, Nat.succ_mul], by rw [pow_succ, hpow, ofWord_append]⟩

/-- **Long words vanish on a nilpotent module.** If the trace of every nonempty word on `M`
vanishes, every word of length at least `dim M` acts on `M` as zero. -/
theorem ofWord_smul_eq_zero_of_traceWord_eq_zero
    (h : ∀ w : List (Fin d), w ≠ [] → traceWord M w = 0)
    {w : List (Fin d)} (hw : Module.finrank ℂ M ≤ w.length) (m : M) :
    (ofWord w : WordAlgebra d) • m = 0 := by
  classical
  let ρ : WordAlgebra d →ₐ[ℂ] Module.End ℂ M := Algebra.lsmul ℂ ℂ M
  let S : NonUnitalSubalgebra ℂ (Module.End ℂ M) :=
    NonUnitalAlgebra.adjoin ℂ (Set.range fun i : Fin d => ρ (ofWord [i]))
  -- the subsemigroup generated by the letters consists of nonempty words
  have hword : ∀ X ∈ Subsemigroup.closure (Set.range fun i : Fin d => ρ (ofWord [i])),
      ∃ u : List (Fin d), u ≠ [] ∧ X = ρ (ofWord u) := by
    intro X hX
    induction hX using Subsemigroup.closure_induction with
    | mem X hX =>
      obtain ⟨i, rfl⟩ := hX
      exact ⟨[i], List.cons_ne_nil _ _, rfl⟩
    | mul X Y _ _ hX hY =>
      obtain ⟨u, hu, rfl⟩ := hX
      obtain ⟨v, -, rfl⟩ := hY
      exact ⟨u ++ v, by simp [hu], by rw [ofWord_append, map_mul]⟩
  -- every element of `S` has trace zero
  have htrace : ∀ X ∈ S, LinearMap.trace ℂ M X = 0 := by
    intro X hX
    change X ∈ (NonUnitalAlgebra.adjoin ℂ _).toSubmodule at hX
    rw [NonUnitalAlgebra.adjoin_eq_span] at hX
    induction hX using Submodule.span_induction with
    | mem X hX =>
      obtain ⟨u, hu, rfl⟩ := hword X hX
      exact h u hu
    | zero => simp
    | add X Y _ _ hX hY => rw [map_add, hX, hY, add_zero]
    | smul c X _ hX => rw [map_smul, hX, smul_zero]
  have hpow : ∀ X ∈ S, ∀ N : ℕ, X ^ (N + 1) ∈ S := by
    intro X hX N
    induction N with
    | zero => simpa using hX
    | succ N ih => rw [pow_succ]; exact S.mul_mem ih hX
  -- hence every element of `S` is nilpotent
  have hnil : ∀ X : S, IsNilpotent (X : Module.End ℂ M) := by
    intro X
    let b := Module.finBasis ℂ M
    rw [← LinearMap.isNilpotent_toMatrix_iff b]
    apply Matrix.isNilpotent_of_forall_trace_pow_eq_zero_of_one_lt
    intro N hN
    obtain ⟨N, rfl⟩ : ∃ k, N = k + 1 := ⟨N - 1, by omega⟩
    rw [LinearMap.toMatrix_pow, ← LinearMap.trace_eq_matrix_trace]
    exact htrace _ (hpow _ X.property N)
  -- products of `dim M` letters vanish
  have hlen : ∀ u : List (Fin d), u.length = Module.finrank ℂ M →
      ∀ m : M, (ofWord u : WordAlgebra d) • m = 0 := by
    intro u hu m
    have hprod : ρ (ofWord u) = (u.map fun i => ρ (ofWord [i])).prod := by
      clear hu
      induction u with
      | nil => simp
      | cons i u ih => rw [ofWord_cons, map_mul, ih, List.map_cons, List.prod_cons]
    have h0 : ρ (ofWord u) = 0 := by
      rw [hprod]
      apply S.list_prod_eq_zero_of_forall_isNilpotent hnil
      · intro X hX
        obtain ⟨i, -, rfl⟩ := List.mem_map.mp hX
        exact NonUnitalAlgebra.subset_adjoin ℂ ⟨i, rfl⟩
      · simpa using hu
    simpa [ρ] using LinearMap.congr_fun h0 m
  exact ofWord_smul_eq_zero_of_length_le hlen hw m

omit [FiniteDimensional ℂ M] in
/-- If every word of some length `n` acts on `M` as zero, the trace of every nonempty word on
`M` vanishes. -/
theorem traceWord_eq_zero_of_forall_ofWord_smul_eq_zero {n : ℕ}
    (h : ∀ w : List (Fin d), w.length = n → ∀ m : M, (ofWord w : WordAlgebra d) • m = 0)
    {w : List (Fin d)} (hw : w ≠ []) : traceWord M w = 0 := by
  have hpos : 0 < w.length := by
    cases w with
    | nil => exact absurd rfl hw
    | cons _ _ => simp
  have hnil : IsNilpotent (Algebra.lsmul ℂ ℂ M (ofWord w : WordAlgebra d)) := by
    obtain ⟨u, hu, hpow⟩ := exists_ofWord_pow_eq w n
    refine ⟨n, LinearMap.ext fun m => ?_⟩
    rw [← map_pow, hpow, Algebra.lsmul_apply, LinearMap.zero_apply]
    exact ofWord_smul_eq_zero_of_length_le h (hu ▸ Nat.le_mul_of_pos_right n hpos) m
  rw [traceWord_def]
  exact (LinearMap.isNilpotent_trace_of_isNilpotent hnil).eq_zero

end WordAlgebra

section SimpleSeparation

namespace WordAlgebra

variable {d : ℕ}

/-- A vector reached from a nonzero vector: there is a `ℂ`-linear map sending `x` to `y`
whenever `x ≠ 0`. -/
lemma exists_linearMap_apply_eq {Q : Type*} [AddCommGroup Q] [Module ℂ Q] {x : Q} (hx : x ≠ 0)
    (y : Q) : ∃ g : Q →ₗ[ℂ] Q, g x = y := by
  have hinj : LinearMap.ker (LinearMap.toSpanSingleton ℂ Q x) = ⊥ :=
    LinearMap.ker_toSpanSingleton ℂ hx
  obtain ⟨ℓ, hℓ⟩ := LinearMap.exists_leftInverse_of_injective _ hinj
  refine ⟨ℓ.smulRight y, ?_⟩
  have : ℓ x = 1 := by
    have := LinearMap.congr_fun hℓ 1
    simpa using this
  simp [this]

section Burnside

variable (Q : Type*) [AddCommGroup Q] [Module ℂ Q] [Module (WordAlgebra d) Q]
  [IsScalarTower ℂ (WordAlgebra d) Q] [FiniteDimensional ℂ Q] [IsSimpleModule (WordAlgebra d) Q]

/-- Burnside's theorem at module level: every `ℂ`-linear endomorphism of a finite-dimensional
simple module over the word algebra is the action of some element (Schur's lemma over an
algebraically closed field and the Jacobson density theorem). -/
theorem exists_smul_eq_of_isSimpleModule (g : Q →ₗ[ℂ] Q) :
    ∃ a : WordAlgebra d, ∀ q : Q, a • q = g q := by
  set R := WordAlgebra d
  have hSchur : Function.Bijective (algebraMap ℂ (Module.End R Q)) :=
    IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed (k := ℂ) (A := R) (V := Q)
  -- `Q` is finite over its commutant, which consists of scalars.
  have : Module.Finite (Module.End R Q) Q := by
    have : RingHomSurjective (algebraMap ℂ (Module.End R Q)) := ⟨hSchur.2⟩
    let f : Q →ₛₗ[algebraMap ℂ (Module.End R Q)] Q :=
      LinearMap.mk (toAddHom := AddMonoidHom.id Q) (map_smul' := by
        intro c v
        simp [Algebra.algebraMap_eq_smul_one])
    exact Module.Finite.of_surjective (f := f) fun v => ⟨v, rfl⟩
  have : SMulCommClass R (Module.End R Q) Q := ⟨fun r f v => by simp [f.map_smul r v]⟩
  have hJD : Function.Surjective (Module.toModuleEnd (Module.End R Q) Q) :=
    Module.Finite.toModuleEnd_moduleEnd_surjective (R := R) (M := Q)
  -- Regard `g` as `Module.End R Q`-linear using surjectivity of `algebraMap`.
  let g' : Module.End (Module.End R Q) Q :=
    { toFun := fun v => g v
      map_add' := fun v w => g.map_add v w
      map_smul' := by
        intro φ v
        obtain ⟨c, rfl⟩ := hSchur.2 φ
        simp [Algebra.algebraMap_eq_smul_one] }
  obtain ⟨a, ha⟩ := hJD g'
  refine ⟨a, fun q => ?_⟩
  have := LinearMap.congr_fun ha q
  simpa [Module.toModuleEnd_apply, g'] using this

/-- On a simple module with some generator acting nonzero, an element of the positive ideal acts
as the identity: the two-sided ideal generated by a nonzero endomorphism of a finite-dimensional
space is everything, and every endomorphism is realized by Burnside. -/
theorem exists_aug_eq_zero_smul_eq_self
    (h : ∃ (i : Fin d) (q : Q), (ofWord [i] : WordAlgebra d) • q ≠ 0) :
    ∃ u : WordAlgebra d, aug u = 0 ∧ ∀ q : Q, u • q = q := by
  obtain ⟨i, q₀, hq₀⟩ := h
  classical
  let b := Module.finBasis ℂ Q
  -- `Y j` sends `x_i • q₀` to the basis vector `b j`; `Z j` sends `q` to `coord j q • q₀`.
  choose Y hY using fun j => exists_linearMap_apply_eq hq₀ (b j)
  let Z : Fin (Module.finrank ℂ Q) → Q →ₗ[ℂ] Q := fun j => (b.coord j).smulRight q₀
  choose α hα using fun j => exists_smul_eq_of_isSimpleModule (d := d) Q (Y j)
  choose β hβ using fun j => exists_smul_eq_of_isSimpleModule (d := d) Q (Z j)
  refine ⟨∑ j, α j * ofWord [i] * β j, ?_, fun q => ?_⟩
  · simp [map_sum, aug_ofWord]
  · calc (∑ j, α j * ofWord [i] * β j) • q = ∑ j, Y j (ofWord [i] • Z j q) := by
          rw [Finset.sum_smul]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [mul_smul, mul_smul, hα, hβ]
      _ = ∑ j, b.repr q j • b j := by
          refine Finset.sum_congr rfl fun j _ => ?_
          simp [Z, smul_comm (ofWord [i] : WordAlgebra d), hY j]
      _ = q := b.sum_repr q

end Burnside

section Separation

variable (Q T : Type*) [AddCommGroup Q] [Module ℂ Q] [Module (WordAlgebra d) Q]
  [IsScalarTower ℂ (WordAlgebra d) Q] [FiniteDimensional ℂ Q] [IsSimpleModule (WordAlgebra d) Q]
  [AddCommGroup T] [Module ℂ T] [Module (WordAlgebra d) T]
  [IsScalarTower ℂ (WordAlgebra d) T] [FiniteDimensional ℂ T] [IsSimpleModule (WordAlgebra d) T]

/-- A product of two simple modules is semisimple. -/
instance isSemisimpleModule_prod : IsSemisimpleModule (WordAlgebra d) (Q × T) := by
  have h1 : IsSemisimpleModule (WordAlgebra d) (Submodule.fst (WordAlgebra d) Q T) :=
    IsSemisimpleModule.congr (Submodule.fstEquiv (WordAlgebra d) Q T)
  have h2 : IsSemisimpleModule (WordAlgebra d) (Submodule.snd (WordAlgebra d) Q T) :=
    IsSemisimpleModule.congr (Submodule.sndEquiv (WordAlgebra d) Q T)
  have h3 : IsSemisimpleModule (WordAlgebra d)
      ↥(Submodule.fst (WordAlgebra d) Q T ⊔ Submodule.snd (WordAlgebra d) Q T) :=
    IsSemisimpleModule.sup h1 h2
  rw [Submodule.fst_sup_snd] at h3
  exact IsSemisimpleModule.congr (Submodule.topEquiv).symm

omit [Module ℂ Q] [IsScalarTower ℂ (WordAlgebra d) Q] [FiniteDimensional ℂ Q] [Module ℂ T]
  [IsScalarTower ℂ (WordAlgebra d) T] [FiniteDimensional ℂ T] in
/-- Every endomorphism of `Q × T` preserves the first factor when `Q` and `T` are non-isomorphic
simple modules (Schur's lemma). -/
lemma fst_comp_inr_eq_zero (hne : IsEmpty (Q ≃ₗ[WordAlgebra d] T))
    (φ : Module.End (WordAlgebra d) (Q × T)) :
    (LinearMap.fst (WordAlgebra d) Q T).comp (φ.comp (LinearMap.inr (WordAlgebra d) Q T)) = 0 := by
  rcases LinearMap.bijective_or_eq_zero
      ((LinearMap.fst (WordAlgebra d) Q T).comp (φ.comp (LinearMap.inr (WordAlgebra d) Q T)))
    with hbij | hzero
  · exact (hne.false (LinearEquiv.ofBijective _ hbij).symm).elim
  · exact hzero

omit [Module ℂ Q] [IsScalarTower ℂ (WordAlgebra d) Q] [FiniteDimensional ℂ Q] [Module ℂ T]
  [IsScalarTower ℂ (WordAlgebra d) T] [FiniteDimensional ℂ T] in
lemma snd_comp_inl_eq_zero (hne : IsEmpty (Q ≃ₗ[WordAlgebra d] T))
    (φ : Module.End (WordAlgebra d) (Q × T)) :
    (LinearMap.snd (WordAlgebra d) Q T).comp (φ.comp (LinearMap.inl (WordAlgebra d) Q T)) = 0 := by
  rcases LinearMap.bijective_or_eq_zero
      ((LinearMap.snd (WordAlgebra d) Q T).comp (φ.comp (LinearMap.inl (WordAlgebra d) Q T)))
    with hbij | hzero
  · exact (hne.false (LinearEquiv.ofBijective _ hbij)).elim
  · exact hzero

/-- Two non-isomorphic simple modules are separated by an element of the positive ideal acting as
the identity on the first and as zero on the second (Jacobson density on `Q × T`). -/
theorem exists_aug_eq_zero_smul_eq_self_smul_eq_zero
    (hQ : ∃ (i : Fin d) (q : Q), (ofWord [i] : WordAlgebra d) • q ≠ 0)
    (hne : IsEmpty (Q ≃ₗ[WordAlgebra d] T)) :
    ∃ p : WordAlgebra d, aug p = 0 ∧ (∀ q : Q, p • q = q) ∧ ∀ t : T, p • t = 0 := by
  -- `(Q × T)` is finite over its commutant.
  have : IsScalarTower ℂ (Module.End (WordAlgebra d) (Q × T)) (Q × T) :=
    ⟨fun c φ n => by change (c • φ) n = c • φ n; exact LinearMap.smul_apply c φ n⟩
  have : Module.Finite (Module.End (WordAlgebra d) (Q × T)) (Q × T) :=
    Module.Finite.of_restrictScalars_finite ℂ (Module.End (WordAlgebra d) (Q × T)) (Q × T)
  have : SMulCommClass (WordAlgebra d) (Module.End (WordAlgebra d) (Q × T)) (Q × T) :=
    ⟨fun r f v => by change r • f v = f (r • v); exact (f.map_smul r v).symm⟩
  have hJD :
      Function.Surjective (Module.toModuleEnd (Module.End (WordAlgebra d) (Q × T)) (Q × T)) :=
    Module.Finite.toModuleEnd_moduleEnd_surjective (R := WordAlgebra d) (M := Q × T)
  -- The projection onto the first factor commutes with every endomorphism.
  let g : Module.End (Module.End (WordAlgebra d) (Q × T)) (Q × T) :=
    { toFun := fun n => (n.1, 0)
      map_add' := fun n m => by rw [Prod.fst_add, Prod.mk_add_mk, add_zero]
      map_smul' := by
        intro φ n
        have h1 := LinearMap.congr_fun (fst_comp_inr_eq_zero Q T hne φ) n.2
        have h2 := LinearMap.congr_fun (snd_comp_inl_eq_zero Q T hne φ) n.1
        simp only [LinearMap.comp_apply, LinearMap.fst_apply, LinearMap.inr_apply,
          LinearMap.snd_apply, LinearMap.inl_apply, LinearMap.zero_apply] at h1 h2
        change ((φ n).1, 0) = φ (n.1, 0)
        have hn : (n.1, 0) + (0, n.2) = n := by rw [Prod.mk_add_mk, add_zero, zero_add]
        have hφn : φ n = φ (n.1, 0) + φ (0, n.2) := by rw [← map_add, hn]
        refine Prod.ext ?_ ?_
        · rw [hφn, Prod.fst_add, h1, add_zero]
        · exact h2.symm }
  obtain ⟨a, ha⟩ := hJD g
  obtain ⟨u, hu, hu'⟩ := exists_aug_eq_zero_smul_eq_self Q hQ
  refine ⟨a * u, aug_mul_left hu a, fun q => ?_, fun t => ?_⟩
  · have h : a • q = q := by
      simpa [Module.toModuleEnd_apply, g, Prod.smul_fst] using
        congrArg Prod.fst (LinearMap.congr_fun ha (q, 0))
    rw [mul_smul, hu', h]
  · have h : a • (u • t) = 0 := by
      simpa [Module.toModuleEnd_apply, g, Prod.smul_snd] using
        congrArg Prod.snd (LinearMap.congr_fun ha (0, u • t))
    rw [mul_smul, h]

end Separation

end WordAlgebra

end SimpleSeparation

section

open scoped Matrix

namespace WordAlgebra

variable {d : ℕ} {M : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M]

/-- A complex subspace invariant under the action of every one-letter word is invariant under the
action of the whole word algebra: the words span the algebra, and a word acts as the composite of
its letters. -/
theorem smul_mem_of_forall_ofWord_smul_mem {N : Submodule ℂ M}
    (hN : ∀ (i : Fin d), ∀ x ∈ N, (ofWord [i] : WordAlgebra d) • x ∈ N) (p : WordAlgebra d)
    {x : M} (hx : x ∈ N) : p • x ∈ N := by
  have hword : ∀ w : List (Fin d), ∀ y ∈ N, (ofWord w : WordAlgebra d) • y ∈ N := by
    intro w
    induction w with
    | nil => intro y hy; rwa [ofWord_nil, one_smul]
    | cons i w ih => intro y hy; rw [ofWord_cons, mul_smul]; exact hN i _ (ih y hy)
  induction p using MonoidAlgebra.induction_on with
  | of g =>
    change (ofWord (FreeMonoid.toList g) : WordAlgebra d) • x ∈ N
    exact hword _ x hx
  | add f g hf hg => rw [add_smul]; exact N.add_mem hf hg
  | smul r f hf => rw [smul_assoc]; exact N.smul_mem r hf

/-- A complex subspace invariant under every one-letter word, read as a word-algebra
submodule. -/
def submoduleOfLetterInvariant (N : Submodule ℂ M)
    (hN : ∀ (i : Fin d), ∀ x ∈ N, (ofWord [i] : WordAlgebra d) • x ∈ N) :
    Submodule (WordAlgebra d) M where
  carrier := N
  add_mem' := N.add_mem
  zero_mem' := N.zero_mem
  smul_mem' p _ hx := smul_mem_of_forall_ofWord_smul_mem hN p hx

@[simp] theorem mem_submoduleOfLetterInvariant {N : Submodule ℂ M}
    {hN : ∀ (i : Fin d), ∀ x ∈ N, (ofWord [i] : WordAlgebra d) • x ∈ N} {x : M} :
    x ∈ submoduleOfLetterInvariant N hN ↔ x ∈ N := Iff.rfl

end WordAlgebra

end

section

universe u

namespace WordAlgebra

variable {d : ℕ}

section Congr

variable {M N : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [AddCommGroup N] [Module ℂ N] [Module (WordAlgebra d) N]
  [IsScalarTower ℂ (WordAlgebra d) N]

/-- Word traces are invariant under isomorphism of word-algebra modules. -/
lemma traceWord_congr (e : M ≃ₗ[WordAlgebra d] N) (w : List (Fin d)) :
    traceWord M w = traceWord N w := by
  have : Algebra.lsmul ℂ ℂ N (ofWord w) =
      (e.restrictScalars ℂ).conj (Algebra.lsmul ℂ ℂ M (ofWord w)) := by
    ext n
    simp [LinearEquiv.conj_apply, map_smul]
  rw [traceWord_def, traceWord_def, this, LinearMap.trace_conj']

/-- Word traces of a product module add. -/
lemma traceWord_prod [FiniteDimensional ℂ M] [FiniteDimensional ℂ N] (w : List (Fin d)) :
    traceWord (M × N) w = traceWord M w + traceWord N w := by
  have : Algebra.lsmul ℂ ℂ (M × N) (ofWord w) =
      (Algebra.lsmul ℂ ℂ M (ofWord w)).prodMap (Algebra.lsmul ℂ ℂ N (ofWord w)) := by
    ext m <;> simp
  rw [traceWord_def, this, LinearMap.trace_prodMap', traceWord_def, traceWord_def]

end Congr

section Quotient

variable {M : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [FiniteDimensional ℂ M]

/-- Word traces are additive over an invariant submodule: the trace on `M` is the trace on `K`
plus the trace on `M ⧸ K`. -/
lemma traceWord_eq_add_quotient (K : Submodule (WordAlgebra d) M) (w : List (Fin d)) :
    traceWord M w = traceWord K w + traceWord (M ⧸ K) w := by
  have hf : ∀ x ∈ K.restrictScalars ℂ, Algebra.lsmul ℂ ℂ M (ofWord w) x ∈ K.restrictScalars ℂ :=
    fun x hx => K.smul_mem _ hx
  rw [traceWord_def, LinearMap.trace_eq_trace_restrict_add_trace_quotient (K.restrictScalars ℂ)
    (Algebra.lsmul ℂ ℂ M (ofWord w)) hf, traceWord_def, traceWord_def]
  congr 1

/-- Word traces are additive over a step `A ≤ B` of invariant subspaces: the trace on `B` is the
trace on `A` plus the trace on `B / A` (blueprint `lem:asym_trace_additivity`, *Trace additivity
over an invariant submodule*). -/
lemma traceWord_eq_add_subquot {A B : Submodule (WordAlgebra d) M} (hAB : A ≤ B)
    (w : List (Fin d)) :
    traceWord B w = traceWord A w + traceWord (Submodule.subquot A B) w := by
  have : FiniteDimensional ℂ B :=
    Module.Finite.of_injective (B.subtype.restrictScalars ℂ) B.subtype_injective
  rw [traceWord_eq_add_quotient (A.comap B.subtype) w,
    traceWord_congr (Submodule.comapSubtypeEquivOfLe hAB) w]

omit [FiniteDimensional ℂ M] in
/-- Word traces vanish on the zero subspace. -/
lemma traceWord_bot (w : List (Fin d)) :
    traceWord (⊥ : Submodule (WordAlgebra d) M) w = 0 := by
  rw [traceWord_def, Subsingleton.elim (Algebra.lsmul ℂ ℂ (⊥ : Submodule (WordAlgebra d) M)
    (ofWord w : WordAlgebra d)) 0, map_zero]

/-- **Traces along an invariant flag** (*The asymmetric fundamental theorem of matrix product
states*, Lemma 4.1), module form: for a chain `0 = N_0 ≤ N_1 ≤ ⋯ ≤ N_r` of invariant subspaces, the
word trace on `N_r` is the sum of the word traces on the steps `N_k / N_{k-1}`. -/
lemma traceWord_eq_sum_subquot {r : ℕ} (N : Fin (r + 1) → Submodule (WordAlgebra d) M)
    (h0 : N 0 = ⊥) (hmono : Monotone N) (w : List (Fin d)) :
    traceWord (N (Fin.last r)) w =
      ∑ k : Fin r, traceWord (Submodule.subquot (N k.castSucc) (N k.succ)) w := by
  induction r with
  | zero =>
    rw [Fin.last_zero, h0, traceWord_bot, Finset.univ_eq_empty, Finset.sum_empty]
  | succ r ih =>
    rw [Fin.sum_univ_castSucc]
    have h := ih (N ∘ Fin.castSucc) h0 (hmono.comp Fin.strictMono_castSucc.monotone)
    simp only [Function.comp_apply] at h
    simp only [Fin.succ_castSucc]
    rw [← h, ← Fin.succ_last, traceWord_eq_add_subquot (hmono (Fin.castSucc_le_succ _))]

end Quotient

end WordAlgebra

end

section

open scoped Matrix

namespace WordAlgebra

variable {d : ℕ} {M N : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [AddCommGroup N] [Module ℂ N] [Module (WordAlgebra d) N]
  [IsScalarTower ℂ (WordAlgebra d) N]

/-- A complex-linear map between word-algebra modules that commutes with the action of every
one-letter word commutes with the action of the whole word algebra. -/
def linearMapOfLetter (f : M →ₗ[ℂ] N)
    (hf : ∀ (i : Fin d) (x : M), f ((ofWord [i] : WordAlgebra d) • x) =
      (ofWord [i] : WordAlgebra d) • f x) : M →ₗ[WordAlgebra d] N where
  toFun := f
  map_add' := f.map_add
  map_smul' p x := by
    have hword : ∀ (w : List (Fin d)) (y : M),
        f ((ofWord w : WordAlgebra d) • y) = (ofWord w : WordAlgebra d) • f y := by
      intro w
      induction w with
      | nil => intro y; rw [ofWord_nil, one_smul, one_smul]
      | cons i w ih => intro y; rw [ofWord_cons, mul_smul, mul_smul, hf, ih]
    change f (p • x) = p • f x
    induction p using MonoidAlgebra.induction_on with
    | of g => exact hword (FreeMonoid.toList g) x
    | add p q hp hq => rw [add_smul, add_smul, f.map_add, hp, hq]
    | smul r p hp => rw [smul_assoc, f.map_smul, hp, smul_assoc]

@[simp] theorem linearMapOfLetter_apply (f : M →ₗ[ℂ] N)
    (hf : ∀ (i : Fin d) (x : M), f ((ofWord [i] : WordAlgebra d) • x) =
      (ofWord [i] : WordAlgebra d) • f x) (x : M) : linearMapOfLetter f hf x = f x := rfl

end WordAlgebra

end

section

namespace WordAlgebra

variable {d : ℕ} {M N : Type*} [AddCommGroup M] [Module ℂ M] [Module (WordAlgebra d) M]
  [IsScalarTower ℂ (WordAlgebra d) M] [AddCommGroup N] [Module ℂ N] [Module (WordAlgebra d) N]
  [IsScalarTower ℂ (WordAlgebra d) N]

/-- A complex-linear equivalence commuting with every letter is an equivalence of word-algebra
modules. -/
noncomputable def linearEquivOfLetter (e : M ≃ₗ[ℂ] N)
    (h : ∀ (i : Fin d) (x : M), e ((ofWord [i] : WordAlgebra d) • x) = (ofWord [i]) • e x) :
    M ≃ₗ[WordAlgebra d] N :=
  { linearMapOfLetter e.toLinearMap h with
    invFun := e.symm
    left_inv := e.left_inv
    right_inv := e.right_inv }

@[simp]
theorem linearEquivOfLetter_apply (e : M ≃ₗ[ℂ] N)
    (h : ∀ (i : Fin d) (x : M), e ((ofWord [i] : WordAlgebra d) • x) = (ofWord [i]) • e x)
    (x : M) : linearEquivOfLetter e h x = e x :=
  rfl

end WordAlgebra

end
