import Mathlib.Algebra.Algebra.Basic
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.List.OfFn
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.UnitaryGroup

/-!
# Ordered products indexed by finite initial segments

This file collects identities for ordered, generally noncommutative products whose factors are
indexed by `Fin`: distributivity over finite sums, extraction of scalar coefficients, the
compatibility of `Fin` tuple constructors with `List.ofFn`, peeling off the last factor of
`Fin.prod`, commuting a fixed matrix through an ordered product of alternating factors, and
splitting a sum over configurations of `m + 1` sites into the first site and the rest.

The ordered-product identities for `Fin.prod` are the domain-free steps of the
sequential-generation schemes of arXiv:quant-ph/0608197, Section 5.

Moved from TNLean, `TNLean/Algebra/ListProduct.lean`, `TNLean/Algebra/ListOfFn.lean` and
`TNLean/Algebra/FinOrderedProduct.lean` at commit `49b78ed821` (Apache-2.0). Changes: the three
files are merged.

## Main results

* `List.prod_ofFn_sum`: distributes an ordered product over finite sums.
* `List.prod_ofFn_smul`: extracts the product of scalar coefficients.
* `Subsemigroup.exists_nonempty_list_prod_of_mem_closure`: represents an element of a
  generated subsemigroup as a nonempty product of generators.
* `List.ofFn_snoc`, `List.exists_eq_ofFn`: appending to a tuple, and every list as `List.ofFn`.
* `Fin.prod_succ'`: `x₀ ⋯ x_m = (x₀ ⋯ x_{m-1}) x_m`.
* `Fin.prod_mul_mul_eq`: `(E R₀)(E R₁) ⋯ (E R_{m-1}) E = E (R₀ E) ⋯ (R_{m-1} E)`.
* `Fintype.sum_fin_succ_pi`: splitting a configuration sum at the first site.
-/

open scoped BigOperators

namespace List

/-- An ordered product of finite sums is the sum over all choices of the corresponding
ordered products. -/
theorem prod_ofFn_sum {R J : Type*} [Semiring R] [Fintype J]
    {N : ℕ} (f : Fin N → J → R) :
    (List.ofFn fun n : Fin N ↦ ∑ j : J, f n j).prod =
      ∑ choice : Fin N → J, (List.ofFn fun n ↦ f n (choice n)).prod := by
  classical
  induction N with
  | zero => simp
  | succ N ih =>
      rw [List.ofFn_succ, List.prod_cons, ih (fun n ↦ f n.succ), Finset.sum_mul_sum]
      rw [← Equiv.sum_comp (Fin.consEquiv fun _ : Fin (N + 1) ↦ J),
        Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun j _ ↦ Finset.sum_congr rfl (fun choice _ ↦ ?_))
      rw [List.ofFn_succ, List.prod_cons]
      simp [Fin.consEquiv]

/-- Scalars extract from an ordered product as their commutative product. -/
theorem prod_ofFn_smul {𝕜 R : Type*} [CommSemiring 𝕜] [Semiring R] [Algebra 𝕜 R]
    {N : ℕ} (c : Fin N → 𝕜) (A : Fin N → R) :
    (List.ofFn fun n : Fin N ↦ c n • A n).prod =
      (∏ n : Fin N, c n) • (List.ofFn A).prod := by
  induction N with
  | zero => simp
  | succ N ih =>
      rw [List.ofFn_succ, List.prod_cons, ih (fun n ↦ c n.succ) (fun n ↦ A n.succ),
        smul_mul_smul_comm, Fin.prod_univ_succ, List.ofFn_succ, List.prod_cons]

end List

namespace Subsemigroup

/-- Every element of the subsemigroup generated by `s` is a nonempty product of elements
of `s`. -/
theorem exists_nonempty_list_prod_of_mem_closure
    {M : Type*} [Monoid M] {s : Set M} {x : M}
    (hx : x ∈ Subsemigroup.closure s) :
    ∃ l : List M, l ≠ [] ∧ (∀ a ∈ l, a ∈ s) ∧ l.prod = x := by
  induction hx using Subsemigroup.closure_induction with
  | mem x hx => exact ⟨[x], by simp, by simpa, by simp⟩
  | mul x y _ _ hx hy =>
      obtain ⟨lx, hlx, hlxs, hxl⟩ := hx
      obtain ⟨ly, hly, hlys, hyl⟩ := hy
      refine ⟨lx ++ ly, ?_, ?_, ?_⟩
      · simp [hlx]
      · intro a ha
        exact List.mem_append.mp ha |>.elim (hlxs a) (hlys a)
      · rw [List.prod_append, hxl, hyl]

end Subsemigroup

namespace List

/-- Appending one value to a finite tuple appends the same value to its list. -/
theorem ofFn_snoc {α : Type*} {n : ℕ} (f : Fin n → α) (x : α) :
    List.ofFn (Fin.snoc f x) = List.ofFn f ++ [x] := by
  conv_lhs => rw [List.ofFn_succ' (Fin.snoc f x)]
  simp [Fin.snoc_castSucc, Fin.snoc_last]

/-- Every list is `List.ofFn` of some function on `Fin n`, namely its own `get`; a proof can
write `obtain ⟨L, σ, rfl⟩ := List.exists_eq_ofFn w`. -/
theorem exists_eq_ofFn {α : Type*} (l : List α) : ∃ n, ∃ f : Fin n → α, l = List.ofFn f :=
  ⟨_, _, (List.ofFn_get l).symm⟩

end List

namespace Fin

/-- Peeling off the last factor of an ordered product. -/
theorem prod_succ' {α : Type*} [Monoid α] {m : ℕ} (x : Fin (m + 1) → α) :
    Fin.prod x = Fin.prod (fun p => x p.castSucc) * x (Fin.last m) := by
  simp only [Fin.prod_eq_prod_map_finRange, ← List.ofFn_eq_map, List.ofFn_succ',
    List.prod_concat]

/-- An ordered product of factors `E R_p` followed by `E` is `E` followed by the
ordered product of the factors `R_p E`. -/
theorem prod_mul_mul_eq {ι κ R : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι]
    [DecidableEq κ] [CommSemiring R] (E : Matrix ι κ R) :
    ∀ {m : ℕ} (F : Fin m → Matrix κ ι R),
      Fin.prod (fun p => E * F p) * E = E * Fin.prod (fun p => F p * E)
  | 0, _ => by simp
  | m + 1, F => by
    rw [Fin.prod_succ, Fin.prod_succ, Matrix.mul_assoc, prod_mul_mul_eq E (fun p => F p.succ),
      ← Matrix.mul_assoc, ← Matrix.mul_assoc, Matrix.mul_assoc E]

end Fin

namespace Fintype

/-- Splitting a sum over configurations `τ : Fin (m + 1) → α` into the value at
the first site and the configuration of the remaining sites. -/
theorem sum_fin_succ_pi {α M : Type*} [Fintype α] [AddCommMonoid M] {m : ℕ}
    (f : α → (Fin m → α) → M) :
    ∑ τ : Fin (m + 1) → α, f (τ 0) (fun p => τ p.succ) = ∑ τ', ∑ j, f j τ' := by
  classical
  rw [← (Fin.consEquiv fun _ : Fin (m + 1) => α).sum_comp, Fintype.sum_prod_type,
    Finset.sum_comm]
  simp [Fin.consEquiv_apply]

end Fintype
