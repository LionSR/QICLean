import QICLean.Algebra.PositiveSemidefiniteNormalization
import QICLean.Channel.Irreducible.Ergodicity
import QICLean.Channel.Peripheral.CesaroRecurrence
import QICLean.Channel.Schwarz.Closure
import Mathlib.LinearAlgebra.Eigenspace.Zero

/-!
# Primitive positive maps: Wolf Theorem 6.7

The map is only positive and trace preserving. No complete positivity or
Schwarz inequality is assumed. The iterate condition uses positive integers:
including the zeroth iterate would require the identity to be irreducible.
The peripheral subspace is defined using maximal generalized eigenspaces,
so its dimension counts algebraic multiplicity.

Source: `Notes/WolfNoteTexSource/ch06_spectral_properties.tex`, lines 835--890.
Wolf Theorem 6.8 is the separate completely positive theorem. The index and
dimension conventions are documented in
`docs/paper-gaps/wolf_theorem67_positive_iterates.tex`.
-/

open Filter Matrix TNLean
open scoped Topology Matrix ComplexOrder MatrixOrder Matrix.Norms.Frobenius

noncomputable section

attribute [local instance]
  ContinuousLinearMap.toNormedAddCommGroup
  ContinuousLinearMap.toNormedSpace
  ContinuousLinearMap.toSeminormedRing
  ContinuousLinearMap.toNormedRing
  ContinuousLinearMap.toNormedAlgebra

namespace WolfTheorem67

variable {D : ℕ} [NeZero D]

local notation "Mat" => Matrix (Fin D) (Fin D) ℂ
local notation "End" => Module.End ℂ Mat

/-- Wolf Theorem 6.7(1): one iterate sends every density matrix to a positive
definite matrix, with a single exponent independent of the input. -/
def HasStrictlyPositivePower (T : End) : Prop :=
  ∃ n : ℕ, ∀ ρ ∈ densityMatrices D, ((T ^ n) ρ).PosDef

/-- Wolf Theorem 6.7(2). The source's natural iterate index means `k > 0`;
the recurrent peripheral projection is required to be irreducible as well. -/
def HasIrreduciblePowers (T : End) : Prop :=
  (∀ k : ℕ, 0 < k → IsIrreducibleMap (T ^ k)) ∧
    IsIrreducibleMap T.peripheralProjection

/-- Wolf Theorem 6.7(3): every density matrix converges to the same faithful
density matrix. Stationarity and uniqueness are consequences. -/
def ConvergesToFaithfulDensity (T : End) : Prop :=
  ∃ σ ∈ densityMatrices D, σ.PosDef ∧
    ∀ ρ ∈ densityMatrices D, Tendsto (fun n : ℕ ↦ (T ^ n) ρ) atTop (𝓝 σ)

/-- Wolf Theorem 6.7(4), counting algebraic multiplicity: the full generalized
peripheral subspace is the line generated by a faithful stationary density.
Normalization of the positive eigenvector is harmless by trace preservation. -/
def HasSimpleFaithfulPeripheralSpectrum (T : End) : Prop :=
  ∃ σ ∈ densityMatrices D, σ.PosDef ∧ T σ = σ ∧
    T.peripheralSubspace = ℂ ∙ σ

omit [NeZero D] in
/-- The generalized peripheral-line condition is exactly the literal spectral
clause of Wolf Theorem 6.7(4): the peripheral set is `{1}`, the root `1` of
the characteristic polynomial has multiplicity one, and its eigenvector can
be chosen as a faithful density. In particular, set-level primitivity alone
is insufficient. -/
theorem simpleFaithfulPeripheralSpectrum_iff
    (T : End) :
    HasSimpleFaithfulPeripheralSpectrum T ↔
      IsPrimitive T ∧ T.charpoly.rootMultiplicity 1 = 1 ∧
        ∃ σ ∈ densityMatrices D, σ.PosDef ∧ T σ = σ := by
  constructor
  · rintro ⟨σ, hσ, hσpd, hσfix, hline⟩
    have hσne : σ ≠ 0 := by
      intro hz
      simpa only [hz, Matrix.trace_zero, zero_ne_one] using hσ.2
    have hprim : IsPrimitive T := by
      apply isPrimitive_of_unique_norm_one T σ hσfix hσne
      intro μ hμ hμnorm
      obtain ⟨X, hX⟩ := hμ.exists_hasEigenvector
      have hXin : X ∈ T.peripheralSubspace :=
        (le_biSup (fun μ ↦ T.maxGenEigenspace μ)
          (show μ ∈ peripheralEigenvalues T from ⟨hμ, hμnorm⟩))
          (Module.End.eigenspace_le_maxGenEigenspace hX.1)
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hline ▸ hXin)
      have hfixX : T X = X := by rw [← hc, map_smul, hσfix]
      have heq : μ • X = (1 : ℂ) • X := by
        simpa only [one_smul, hfixX] using
          (Module.End.mem_eigenspace_iff.mp hX.1).symm
      exact (smul_left_injective ℂ hX.2) heq
    have hspace : T.peripheralSubspace = T.maxGenEigenspace 1 := by
      rw [Module.End.peripheralSubspace, show peripheralEigenvalues T = {1} from hprim]
      simp
    refine ⟨hprim, ?_, σ, hσ, hσpd, hσfix⟩
    rw [← LinearMap.finrank_maxGenEigenspace_eq, ← hspace, hline]
    exact finrank_span_singleton hσne
  · rintro ⟨hprim, hmult, σ, hσ, hσpd, hσfix⟩
    have hσne : σ ≠ 0 := by
      intro hz
      simpa only [hz, Matrix.trace_zero, zero_ne_one] using hσ.2
    refine ⟨σ, hσ, hσpd, hσfix, ?_⟩
    rw [Module.End.peripheralSubspace, show peripheralEigenvalues T = {1} from hprim]
    simp only [Set.mem_singleton_iff, iSup_iSup_eq_left]
    symm
    apply Submodule.eq_of_le_of_finrank_eq
    · exact (Submodule.span_singleton_le_iff_mem _ _).mpr
        (Module.End.eigenspace_le_maxGenEigenspace
          (Module.End.mem_eigenspace_iff.mpr (by simpa using hσfix)))
    · rw [finrank_span_singleton hσne, LinearMap.finrank_maxGenEigenspace_eq, hmult]

omit [NeZero D] in
private theorem irreducible_of_fixed_density_posDef
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T)
    (hfixed : ∀ ρ ∈ densityMatrices D, T ρ = ρ → ρ.PosDef) :
    IsIrreducibleMap T := by
  intro P hP hpres
  by_cases hP0 : P = 0
  · exact Or.inl hP0
  right
  obtain ⟨ρ, hρ, hcorner, hfix⟩ :=
    IsPositiveMap.exists_fixed_density_of_preserves_compression
      T hT hTP hP hP0 hpres
  have hρunit := (hfixed ρ hρ hfix).isUnit
  have hdet : Matrix.det P ≠ 0 := by
    intro hz
    have heq := congrArg Matrix.det hcorner
    simp only [Matrix.det_mul, hz, zero_mul] at heq
    exact ((Matrix.isUnit_iff_isUnit_det ρ).mp hρunit).ne_zero heq.symm
  exact (IsIdempotentElem.iff_eq_one_of_isUnit
    ((Matrix.isUnit_iff_isUnit_det P).mpr (isUnit_iff_ne_zero.mpr hdet))).mp hP.2

omit [NeZero D] in
private theorem pow_apply_fixed {T : End} {ρ : Mat} (hρ : T ρ = ρ) (n : ℕ) :
    (T ^ n) ρ = ρ := by
  induction n with
  | zero => simp
  | succ n ih => simpa only [pow_succ', Module.End.mul_apply, ih] using hρ

/-- Wolf Theorem 6.7, (1) implies (2). Compactness of the density matrices
passes the strict-positivity conclusion through the recurrent subsequence. -/
theorem irreduciblePowers_of_strictlyPositivePower
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T)
    (h : HasStrictlyPositivePower T) : HasIrreduciblePowers T := by
  obtain ⟨n, hn⟩ := h
  have hmem (m : ℕ) {ρ : Mat} (hρ : ρ ∈ densityMatrices D) :
      (T ^ m) ρ ∈ densityMatrices D :=
    ⟨hT.pow m ρ hρ.1, (hTP.pow m ρ).trans hρ.2⟩
  constructor
  · intro k hk
    apply irreducible_of_fixed_density_posDef (T ^ k) (hT.pow k) (hTP.pow k)
    intro ρ hρ hfix
    have hkn : n ≤ k * n := by nlinarith
    have heq : (T ^ n) ((T ^ (k * n - n)) ρ) = ρ := by
      rw [← Module.End.mul_apply, ← pow_add, Nat.add_sub_of_le hkn, pow_mul]
      exact pow_apply_fixed hfix n
    rw [← heq]
    exact hn _ (hmem _ hρ)
  · apply irreducible_of_fixed_density_posDef T.peripheralProjection
      (hT.peripheralProjection_isPositiveMap hTP)
      (hT.peripheralProjection_isTracePreservingMap hTP)
    intro ρ hρ hfix
    obtain ⟨s, hs, _, hlim⟩ := hT.exists_strictMono_tendsto_pow_peripheralProjection hTP
    have hclosed : IsClosed ((T ^ n) '' densityMatrices D) :=
      (densityMatrices_isCompact.image (T ^ n).continuous_of_finiteDimensional).isClosed
    have hin : ρ ∈ (T ^ n) '' densityMatrices D := by
      apply hclosed.mem_of_tendsto (by simpa only [hfix] using hlim ρ)
      filter_upwards [hs.tendsto_atTop.eventually (eventually_ge_atTop n)] with i hi
      refine ⟨(T ^ (s i - n)) ρ, hmem _ hρ, ?_⟩
      rw [← Module.End.mul_apply, ← pow_add, Nat.add_sub_of_le hi]
    obtain ⟨τ, hτ, rfl⟩ := hin
    exact hn τ hτ

/-- Wolf Theorem 6.7, (2) implies (4). Irreducibility of the peripheral
projection makes its entire range a faithful stationary line. -/
theorem simpleFaithfulPeripheralSpectrum_of_irreduciblePowers
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T)
    (h : HasIrreduciblePowers T) : HasSimpleFaithfulPeripheralSpectrum T := by
  let P := T.peripheralProjection
  have hP := hT.peripheralProjection_isPositiveMap hTP
  have hPTP := hT.peripheralProjection_isTracePreservingMap hTP
  obtain ⟨σ, hσ, hσpd, hσfix, huniq⟩ :=
    hP.exists_unique_density_fixedPoint_of_irreducible P hPTP h.2
  have hTσ : T σ = σ := by
    apply huniq (T σ) ⟨hT σ hσ.1, (hTP σ).trans hσ.2⟩
    have hc := LinearMap.congr_fun (T.commute_peripheralProjection.eq) σ
    simpa only [Module.End.mul_apply, P, hσfix] using hc
  refine ⟨σ, hσ, hσpd, hTσ, ?_⟩
  apply le_antisymm
  · intro X hX
    have hPX : P X = X := T.peripheralProjection_apply_of_mem hX
    obtain ⟨c, hc⟩ := eigenvector_eq_smul_of_irreducible_positive
      P hP h.2 (r := 1) zero_le_one hσpd (by simpa using hσfix) (by simpa using hPX)
    exact Submodule.mem_span_singleton.mpr ⟨c, hc.symm⟩
  · exact (Submodule.span_singleton_le_iff_mem _ _).mpr
      ((T.peripheralProjection_apply_eq_self_iff σ).mp hσfix)

/-- Wolf Theorem 6.7, (4) implies (3). The complementary generalized
spectral subspace decays; trace preservation identifies the limiting line. -/
theorem convergesToFaithfulDensity_of_simpleFaithfulPeripheralSpectrum
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T)
    (h : HasSimpleFaithfulPeripheralSpectrum T) : ConvergesToFaithfulDensity T := by
  obtain ⟨σ, hσ, hσpd, hσfix, hline⟩ := h
  have hproj (X : Mat) : T.peripheralProjection X = Matrix.trace X • σ := by
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp
      (hline ▸ T.peripheralProjection_apply_mem X)
    have htrace := hT.peripheralProjection_isTracePreservingMap hTP X
    rw [← hc, Matrix.trace_smul, hσ.2, smul_eq_mul, mul_one] at htrace
    simpa only [htrace] using hc.symm
  have hbound : ∀ μ : ℂ, T.HasEigenvalue μ → ‖μ‖ ≤ 1 := fun _ hμ ↦
    (hT.hasBoundedOrbits_of_tracePreserving hTP).norm_le_one_of_hasEigenvalue hμ
  refine ⟨σ, hσ, hσpd, fun ρ hρ ↦ ?_⟩
  have hz := T.tendsto_pow_apply_zero_of_mem_nonPeripheralSubspace
    hbound (T.sub_peripheralProjection_mem ρ)
  have heq (n : ℕ) : (T ^ n) ρ = (T ^ n) (ρ - T.peripheralProjection ρ) + σ := by
    have hPρ : T.peripheralProjection ρ = σ := by simp only [hproj, hρ.2, one_smul]
    rw [hPρ, map_sub, pow_apply_fixed hσfix n, sub_add_cancel]
  have hadd : Tendsto (fun n : ℕ ↦ (T ^ n) (ρ - T.peripheralProjection ρ) + σ)
      atTop (𝓝 σ) := by
    convert hz.add_const σ using 1
    simp only [zero_add]
    rfl
  exact hadd.congr (fun n ↦ (heq n).symm)

private theorem tendsto_apply_of_density_convergence
    (T : End) {σ : Mat}
    (hconv : ∀ ρ ∈ densityMatrices D,
      Tendsto (fun n : ℕ ↦ (T ^ n) ρ) atTop (𝓝 σ)) (X : Mat) :
    Tendsto (fun n : ℕ ↦ (T ^ n) X) atTop (𝓝 (Matrix.trace X • σ)) := by
  have hpsd {Y : Mat} (hY : Y.PosSemidef) :
      Tendsto (fun n : ℕ ↦ (T ^ n) Y) atTop (𝓝 (Matrix.trace Y • σ)) := by
    let τ := Matrix.normalizePosSemidef (0 : Fin D) Y
    have hτ : τ ∈ densityMatrices D :=
      ⟨Matrix.normalizePosSemidef_posSemidef _ hY, Matrix.normalizePosSemidef_trace _ hY⟩
    have heq := Matrix.trace_re_smul_normalizePosSemidef (0 : Fin D) hY
    have htr : Matrix.trace Y = (Y.trace.re : ℂ) := by
      apply Complex.ext
      · simp
      · simpa using (Complex.nonneg_iff.mp hY.trace_nonneg).2.symm
    have hz : Tendsto (fun n : ℕ ↦ (T ^ n) ((Y.trace.re : ℂ) • τ))
        atTop (𝓝 ((Y.trace.re : ℂ) • σ)) := by
      simpa only [map_smul] using (hconv τ hτ).const_smul (Y.trace.re : ℂ)
    have heq' : Matrix.trace Y • τ = Y := by rw [htr]; exact heq
    simpa only [← htr, heq'] using hz
  obtain ⟨P₁, P₂, P₃, P₄, h₁, h₂, h₃, h₄, _, _, _, _, hdecomp⟩ :=
    IsPositiveMap.exists_posSemidef_fixedPoints_decomposition (1 : End)
      (fun _ hY ↦ hY) (fun _ ↦ rfl) (X := X) rfl
  have hz := ((hpsd h₁).sub (hpsd h₂)).const_smul (2⁻¹ : ℂ)
  have hw := ((hpsd h₃).sub (hpsd h₄)).const_smul ((2⁻¹ : ℂ) * Complex.I)
  convert hz.sub hw using 1
  · ext n
    rw [hdecomp]
    simp only [map_sub, map_smul]
  · rw [hdecomp]
    simp only [Matrix.trace_sub, Matrix.trace_smul, smul_sub, sub_smul, smul_smul,
      smul_eq_mul]

/-- Wolf Theorem 6.7, (3) implies (1). Finite-dimensional operator-norm
convergence and compactness give one exponent for all density matrices. -/
theorem strictlyPositivePower_of_convergesToFaithfulDensity
    (T : End) (hT : IsPositiveMap T)
    (h : ConvergesToFaithfulDensity T) : HasStrictlyPositivePower T := by
  obtain ⟨σ, hσ, hσpd, hconv⟩ := h
  let : NormedAddCommGroup (Mat →L[ℂ] Mat) := ContinuousLinearMap.toNormedAddCommGroup
  let : SeminormedRing (Mat →L[ℂ] Mat) := ContinuousLinearMap.toSeminormedRing
  let : NormedRing (Mat →L[ℂ] Mat) := ContinuousLinearMap.toNormedRing
  let : NormedAlgebra ℂ (Mat →L[ℂ] Mat) := ContinuousLinearMap.toNormedAlgebra
  let P : End := (Matrix.traceLinearMap (Fin D) ℂ ℂ).smulRight σ
  let Φ : End ≃ₐ[ℂ] (Mat →L[ℂ] Mat) := Module.End.toContinuousLinearMap Mat
  have hlim : Tendsto (fun n : ℕ ↦ Φ (T ^ n)) atTop (𝓝 (Φ P)) :=
    ContinuousLinearMap.tendsto_of_tendsto_apply_of_finiteDimensional
      (tendsto_apply_of_density_convergence T hconv)
  have hopen : IsOpen {X : Mat | Matrix.det X ≠ 0} :=
    isClosed_singleton.isOpen_compl.preimage continuous_id.matrix_det
  have hdet : Matrix.det σ ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det σ).mp hσpd.isUnit).ne_zero
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hopen σ hdet
  obtain ⟨C, hC, hbound⟩ := densityMatrices_isCompact.isBounded.exists_pos_norm_le
  have hnorm : Tendsto (fun n : ℕ ↦ ‖Φ (T ^ n) - Φ P‖) atTop (𝓝 (0 : ℝ)) := by
    simpa only [sub_self, norm_zero] using
      (hlim.sub (show Tendsto (fun _ : ℕ ↦ Φ P) atTop (𝓝 (Φ P)) from
        tendsto_const_nhds)).norm
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hnorm.eventually (gt_mem_nhds (div_pos hε hC)))
  refine ⟨N, fun ρ hρ ↦ ?_⟩
  have hsmall : ‖(T ^ N) ρ - σ‖ < ε := by
    have hop : ‖Φ (T ^ N) - Φ P‖ < ε / C := hN N le_rfl
    calc
      ‖(T ^ N) ρ - σ‖ = ‖(Φ (T ^ N) - Φ P) ρ‖ := by
        change ‖(T ^ N) ρ - σ‖ = ‖(T ^ N) ρ - Matrix.trace ρ • σ‖
        rw [hρ.2, one_smul]
      _ ≤ ‖Φ (T ^ N) - Φ P‖ * ‖ρ‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ ‖Φ (T ^ N) - Φ P‖ * C :=
        mul_le_mul_of_nonneg_left (hbound ρ hρ) (norm_nonneg _)
      _ < ε := (lt_div_iff₀ hC).mp hop
  exact (hT.pow N ρ hρ.1).posDef_iff_det_ne_zero.mpr
    (hball (by simpa only [Metric.mem_ball, dist_eq_norm] using hsmall))

omit [NeZero D] in
/-- Wolf Theorem 6.7(1) is equivalent to uniform eventual strict positivity:
one threshold works for every later iterate and every density matrix. -/
theorem strictlyPositivePower_iff_uniform_eventual
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T) :
    HasStrictlyPositivePower T ↔
      ∃ n : ℕ, ∀ m : ℕ, n ≤ m → ∀ ρ ∈ densityMatrices D, ((T ^ m) ρ).PosDef := by
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, fun m hm ρ hρ ↦ ?_⟩
    have hmem : (T ^ (m - n)) ρ ∈ densityMatrices D :=
      ⟨hT.pow (m - n) ρ hρ.1, (hTP.pow (m - n) ρ).trans hρ.2⟩
    have hpos := hn _ hmem
    rwa [← Module.End.mul_apply, ← pow_add, Nat.add_sub_of_le hm] at hpos
  · rintro ⟨n, hn⟩
    exact ⟨n, hn n le_rfl⟩

/-- Wolf Theorem 6.7: the four characterizations of primitive positive
trace-preserving maps. Clause (2) quantifies over positive iterates, and
clause (4) explicitly requires characteristic-polynomial multiplicity one.
Source: Wolf Chapter 6, lines 835--890. -/
theorem wolf_theorem_6_7_tfae
    (T : End) (hT : IsPositiveMap T) (hTP : IsTracePreservingMap T) :
    List.TFAE [
      ∃ n : ℕ, ∀ ρ ∈ densityMatrices D, ((T ^ n) ρ).PosDef,
      (∀ k : ℕ, 0 < k → IsIrreducibleMap (T ^ k)) ∧
        IsIrreducibleMap T.peripheralProjection,
      ∃ σ ∈ densityMatrices D, σ.PosDef ∧
        ∀ ρ ∈ densityMatrices D, Tendsto (fun n : ℕ ↦ (T ^ n) ρ) atTop (𝓝 σ),
      IsPrimitive T ∧ T.charpoly.rootMultiplicity 1 = 1 ∧
        ∃ σ ∈ densityMatrices D, σ.PosDef ∧ T σ = σ] := by
  tfae_have 1 → 2 := irreduciblePowers_of_strictlyPositivePower T hT hTP
  tfae_have 2 → 4 := fun h ↦ (simpleFaithfulPeripheralSpectrum_iff T).mp
    (simpleFaithfulPeripheralSpectrum_of_irreduciblePowers T hT hTP h)
  tfae_have 4 → 3 := fun h ↦
    convergesToFaithfulDensity_of_simpleFaithfulPeripheralSpectrum T hT hTP
      ((simpleFaithfulPeripheralSpectrum_iff T).mpr h)
  tfae_have 3 → 1 := strictlyPositivePower_of_convergesToFaithfulDensity T hT
  tfae_finish

end WolfTheorem67
