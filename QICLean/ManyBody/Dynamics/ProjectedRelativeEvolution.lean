import QICLean.ManyBody.Dynamics.HeisenbergEvolution
import QICLean.ManyBody.Sites.Twirl
import QICLean.Analysis.Calculus.ProjectedEvolution

/-!
# A supported projected relative evolution

For Hermitian Hamiltonians `H'` and `H` on a system of sites, project the interaction-picture
observable `e^{itH'} (H' - H) e^{-itH'}` onto a region `K` with the region expectation. The
unique unitary evolution generated by this projection is supported on `K`, and it approximates
the relative evolution `e^{itH'} e^{-itH}` at every real time, with error at most the
generator-projection error times the elapsed time. The path is constructed from the
Hamiltonians and the region; no basis type has to be nonempty.

Source: OpenAI, *Polynomial PEPS approximation of gapped square-grid ground states*,
September 24, 2026, Section 2, lines 513–536, in the argument for `eq:info-local-two-sided`.

Moved from TNLean, `TNLean/Circuit/ProjectedRelativeEvolution.lean` at commit
`71c1185e9352a3b5237b37a6840640751da6ca2d`. Changes: an arbitrary system of sites in place of
`ι → Fin q`; `ManyBody.regionExpectation` in place of `siteExpectation q`, so `[NeZero q]` is
gone; support of the path follows from `ManyBody.mem_supportedOperators_iff_forall_commute`.

## Main definitions

* `ManyBody.projectedRelativeEvolution` — the chosen projected relative evolution.

## Main results

* `ManyBody.exists_supported_projected_relative_evolution` — existence, support, uniqueness
  and the comparison estimate.
* `ManyBody.projectedRelativeEvolution_spec` — the same properties of the chosen path.
-/

open scoped Matrix Matrix.Norms.L2Operator

namespace ManyBody

variable {V : Type*} [Fintype V] [DecidableEq V] {X : V → Type*} [∀ v, Fintype (X v)]
  [∀ v, DecidableEq (X v)]

/-- Projected relative evolution is supported on the projection region, and the same
constructed path satisfies the comparison estimate for all real times. Source:
Polynomial-PEPS, Section 2, lines 513–536. -/
theorem exists_supported_projected_relative_evolution (K : Finset V)
    {H' H : Matrix (Config X) (Config X) ℂ} (hH' : H'.IsHermitian) (hH : H.IsHermitian) :
    ∃ U : ℝ → Matrix (Config X) (Config X) ℂ, U 0 = 1 ∧
      (∀ t, HasDerivAt U
        ((Complex.I • regionExpectation K (heisenbergEvolution H' t (H' - H))) * U t) t) ∧
      (∀ t, U t ∈ Matrix.unitaryGroup (Config X) ℂ) ∧
      (∀ t, U t ∈ supportedOperators X K) ∧
      (∀ W : ℝ → Matrix (Config X) (Config X) ℂ, W 0 = 1 →
        (∀ t, HasDerivAt W
          ((Complex.I • regionExpectation K (heisenbergEvolution H' t (H' - H))) * W t) t) →
        W = U) ∧
      ∀ t ε : ℝ,
        (∀ s ∈ Set.uIcc 0 t,
          ‖heisenbergEvolution H' s (H' - H) -
            regionExpectation K (heisenbergEvolution H' s (H' - H))‖ ≤ ε) →
        ‖Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t) - U t‖ ≤
          ε * |t| := by
  obtain ⟨U, hU0, hU, hunit, huniq, hcompare⟩ :=
    MatrixEvolution.exists_unique_projected_unitary_solution_compare
      (regionExpectationLM K) (fun _ hA ↦ isHermitian_regionExpectation hA)
      norm_regionExpectation_le hH' hH
  refine ⟨U, hU0, hU, hunit, ?_, huniq, hcompare⟩
  refine fun t ↦ mem_supportedOperators_iff_forall_commute.mpr fun B hB ↦ ?_
  exact (MatrixEvolution.commute_of_commute_generator B
    (MatrixEvolution.isHermitian_projectedGenerator
      (regionExpectationLM K) (fun _ hA ↦ isHermitian_regionExpectation hA)
      hH' (hH'.sub hH)) hU0 hU
    (fun _ ↦ commute_of_mem_supportedOperators_of_disjoint hB
      (regionExpectation_mem_supportedOperators K _) disjoint_compl_left) t).symm

/-- **The projected relative evolution**, chosen as the unique solution of the projected
interaction-picture equation with initial value `1`; the existence theorem above supplies
the choice. Source: Polynomial-PEPS, Section 2, lines 513–536. -/
noncomputable def projectedRelativeEvolution (K : Finset V)
    {H' H : Matrix (Config X) (Config X) ℂ} (hH' : H'.IsHermitian) (hH : H.IsHermitian) :
    ℝ → Matrix (Config X) (Config X) ℂ :=
  Classical.choose (exists_supported_projected_relative_evolution K hH' hH)

/-- The chosen projected relative evolution starts at `1`, solves the projected equation, is
unitary and supported on the projection region, is the unique such solution, and satisfies the
comparison estimate. Source: Polynomial-PEPS, Section 2, lines 513–536. -/
theorem projectedRelativeEvolution_spec (K : Finset V)
    {H' H : Matrix (Config X) (Config X) ℂ} (hH' : H'.IsHermitian) (hH : H.IsHermitian) :
    let U := projectedRelativeEvolution K hH' hH
    U 0 = 1 ∧
      (∀ t, HasDerivAt U
        ((Complex.I • regionExpectation K (heisenbergEvolution H' t (H' - H))) * U t) t) ∧
      (∀ t, U t ∈ Matrix.unitaryGroup (Config X) ℂ) ∧
      (∀ t, U t ∈ supportedOperators X K) ∧
      (∀ W : ℝ → Matrix (Config X) (Config X) ℂ, W 0 = 1 →
        (∀ t, HasDerivAt W
          ((Complex.I • regionExpectation K (heisenbergEvolution H' t (H' - H))) * W t) t) →
        W = U) ∧
      ∀ t ε : ℝ,
        (∀ s ∈ Set.uIcc 0 t,
          ‖heisenbergEvolution H' s (H' - H) -
            regionExpectation K (heisenbergEvolution H' s (H' - H))‖ ≤ ε) →
        ‖Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t) - U t‖ ≤
          ε * |t| :=
  Classical.choose_spec (exists_supported_projected_relative_evolution K hH' hH)

end ManyBody
