import QICLean.Analysis.Real.ExplicitThresholds
import QICLean.ManyBody.Dynamics.GraphLocalization
import QICLean.ManyBody.Dynamics.ProjectedRelativeEvolution
import QICLean.Spectral.Filter.Gaussian.MatrixIntegral

/-!
# Supported Gaussian averaging from projection bounds

For two Hermitian operators on a system of sites, construct the unitary evolution generated by
the projection of their relative-evolution generator onto a fixed region. Localize an evolved
observable onto a second region and average its product with that unitary path against the
restricted Gaussian measure.

If the observable and generator projection errors on `[-T, T]` are at most `‖W‖ * εobs` and
`εgen`, respectively, then the average differs from the truncated intertwiner by at most
`‖W‖ * (εobs + T * εgen)`. It is supported in any region containing both projection regions
and has norm at most `‖W‖`. The same path works for every observable, variance, time cutoff
and error bound.

Source: OpenAI, *Polynomial PEPS approximation of gapped square-grid ground states*, Section 2,
`eq:info-local-two-sided`, lines 513–562; TNLean one-dimensional note,
`part2a_mps_information.tex`, lines 381–402. The locality estimates and the physical
Hamiltonians are supplied by each application.

Moved from TNLean, `TNLean/Circuit/SupportedGaussianIntegral.lean` at commit
`71c1185e9352a3b5237b37a6840640751da6ca2d`. Changes: an arbitrary system of sites in place of
`ι → Fin q`; `ManyBody.regionExpectation` in place of `siteExpectation q`, so `[NeZero q]` is
gone; regions are `Finset V` throughout.

## Main results

* `ManyBody.exists_supported_gaussian_integral_of_projection_bounds`.
-/

open MeasureTheory ProbabilityTheory
open scoped Matrix Matrix.Norms.L2Operator NNReal

namespace ManyBody

/-- Supported Gaussian averaging from actual observable and generator projection bounds.
The unitary path is constructed before the observable, variance, cutoff and error bounds.
Source: polynomial-PEPS, Section 2, eq:info-local-two-sided, lines 513–562;
one-dimensional note, part2a_mps_information.tex, lines 381–402. -/
theorem exists_supported_gaussian_integral_of_projection_bounds
    {V : Type*} [Fintype V] [DecidableEq V] {X : V → Type*} [∀ v, Fintype (X v)]
    [∀ v, DecidableEq (X v)]
    {H' H : Matrix (Config X) (Config X) ℂ}
    (hH' : H'.IsHermitian) (hH : H.IsHermitian) (Bgen : Finset V) :
    ∃ U : ℝ → Matrix (Config X) (Config X) ℂ,
      U 0 = 1 ∧
      (∀ t, HasDerivAt U
        ((Complex.I • regionExpectation Bgen
          (heisenbergEvolution H' t (H' - H))) * U t) t) ∧
      (∀ t, U t ∈ Matrix.unitaryGroup (Config X) ℂ) ∧
      (∀ t, U t ∈ supportedOperators X Bgen) ∧
      ∀ (Bobs Bout : Finset V), Bobs ⊆ Bout → Bgen ⊆ Bout →
      ∀ (W : Matrix (Config X) (Config X) ℂ) (η : ℝ≥0) (T : ℝ),
        0 ≤ T →
        ∀ εobs εgen : ℝ, 0 ≤ εobs → 0 ≤ εgen →
        (∀ t : ℝ, |t| ≤ T →
          ‖heisenbergEvolution H' t W -
            regionExpectation Bobs (heisenbergEvolution H' t W)‖ ≤ ‖W‖ * εobs) →
        (∀ t : ℝ, |t| ≤ T →
          ‖heisenbergEvolution H' t (H' - H) -
            regionExpectation Bgen (heisenbergEvolution H' t (H' - H))‖ ≤ εgen) →
        let M := ∫ t : ℝ in Set.Icc (-T) T,
          regionExpectation Bobs (heisenbergEvolution H' t W) * U t
            ∂ProbabilityTheory.gaussianReal 0 η
        M ∈ supportedOperators X Bout ∧
        ‖M‖ ≤ ‖W‖ ∧
        ‖M - GaussianFilter.gaussianIntertwinerTruncated η T H' H W‖ ≤
          ‖W‖ * (εobs + T * εgen) := by
  classical
  obtain ⟨U, hU0, hU, hunit, hsupport, _, hcompare⟩ :=
    exists_supported_projected_relative_evolution Bgen hH' hH
  refine ⟨U, hU0, hU, hunit, hsupport, ?_⟩
  intro Bobs Bout hobsSub hgenSub W η T hT εobs εgen hεobs hεgen hobs hgen M
  have hrelative (t : ℝ) (ht : |t| ≤ T) :
      ‖Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t) - U t‖ ≤
        εgen * |t| :=
    hcompare t _ (fun s hs ↦ hgen s
      ((show |s| ≤ |t| by
        simpa only [sub_zero] using Set.abs_sub_left_of_mem_uIcc hs).trans ht))
  have hfactor (t : ℝ) :
      heisenbergEvolution H' t W *
          (Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t)) =
        Matrix.hermitianUnitaryPath H' t * W * Matrix.hermitianUnitaryPath H (-t) := by
    rw [heisenbergEvolution,
      Matrix.mul_assoc (Matrix.hermitianUnitaryPath H' t * W),
      ← Matrix.mul_assoc (Matrix.hermitianUnitaryPath H' (-t))
        (Matrix.hermitianUnitaryPath H' t),
      ← Matrix.hermitianUnitaryPath_add, neg_add_cancel,
      Matrix.hermitianUnitaryPath_zero, Matrix.one_mul]
  have hpoint (t : ℝ) (ht : |t| ≤ T) :
      ‖regionExpectation Bobs (heisenbergEvolution H' t W) * U t -
        Matrix.hermitianUnitaryPath H' t * W * Matrix.hermitianUnitaryPath H (-t)‖ ≤
          ‖W‖ * (εobs + T * εgen) := by
    refine (hfactor t) ▸ (norm_sub_le_norm_sub_add_norm_sub
      (regionExpectation Bobs (heisenbergEvolution H' t W) * U t)
      (heisenbergEvolution H' t W * U t)
      (heisenbergEvolution H' t W *
        (Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t)))).trans ?_
    rw [← sub_mul, ← mul_sub, CStarRing.norm_mul_mem_unitary _ (hunit t),
      norm_sub_rev (regionExpectation Bobs (heisenbergEvolution H' t W))
        (heisenbergEvolution H' t W)]
    refine (add_le_add (hobs t ht)
      (norm_mul_le_of_le
        (show ‖heisenbergEvolution H' t W‖ ≤ ‖W‖ from
          (SpectralFilter.norm_hermitianUnitaryPath_conj hH' W t).le)
        ((norm_sub_rev (U t)
          (Matrix.hermitianUnitaryPath H' t * Matrix.hermitianUnitaryPath H (-t))).trans_le
            (hrelative t ht)))).trans ?_
    nlinarith [mul_le_mul_of_nonneg_left ht (mul_nonneg (norm_nonneg W) hεgen)]
  let f := fun t : ℝ ↦ regionExpectation Bobs (heisenbergEvolution H' t W) * U t
  have hnorm (t : ℝ) : ‖f t‖ ≤ ‖W‖ :=
    (CStarRing.norm_mul_mem_unitary _ (hunit t)).trans_le
      (MatrixEvolution.norm_projectedGenerator_le (regionExpectationLM Bobs)
        norm_regionExpectation_le hH' W t)
  have hcont : Continuous f :=
    (MatrixEvolution.contDiff_projectedGenerator (regionExpectationLM Bobs)
      H' W 0).continuous.mul
      (show Differentiable ℝ U from fun t ↦ (hU t).differentiableAt).continuous
  have hint : Integrable f (gaussianReal 0 η) :=
    (integrable_const ‖W‖).mono' hcont.aestronglyMeasurable
      (Filter.Eventually.of_forall hnorm)
  have hfix (t : ℝ) : regionExpectation Bout (f t) = f t :=
    regionExpectation_of_mem_supportedOperators (mul_mem
      (supportedOperators_mono hobsSub (regionExpectation_mem_supportedOperators Bobs _))
      (supportedOperators_mono hgenSub (hsupport t)))
  have hMint : regionExpectation Bout M = M :=
    ((regionExpectationLM Bout).toContinuousLinearMap.integral_comp_comm
      (hint.restrict (s := Set.Icc (-T) T))).symm.trans
      (integral_congr_ae (Filter.Eventually.of_forall hfix))
  refine ⟨hMint ▸ regionExpectation_mem_supportedOperators Bout _, ?_, ?_⟩
  · exact (norm_setIntegral_le_of_norm_le_const (measure_lt_top _ _)
      (fun t _ ↦ hnorm t)).trans
        (mul_le_of_le_one_right (norm_nonneg W) measureReal_le_one)
  · change ‖(∫ t : ℝ in Set.Icc (-T) T, f t ∂gaussianReal 0 η) -
      GaussianFilter.gaussianIntertwinerTruncated η T H' H W‖ ≤ _
    rw [GaussianFilter.gaussianIntertwinerTruncated,
      ← integral_sub (hint.restrict (s := Set.Icc (-T) T))
        (GaussianFilter.integrable_intertwinerIntegrand_restrict η T hH' hH W)]
    exact (norm_setIntegral_le_of_norm_le_const (measure_lt_top _ _)
      (fun t ht ↦ hpoint t (abs_le.mpr ht))).trans
        (mul_le_of_le_one_right (by positivity) measureReal_le_one)

section Graph

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {q R : ℕ} {κ : Type*} [Fintype κ]
  {Y : κ → Finset ι}

/-- A single supported unitary path yields the localized truncated Gaussian integrals for
every supported observable, variance and cutoff, on a finite graph whose spheres have at most
two sites. The evolving interaction `Φ` has supports of graph diameter at most `R` and at
most `R + 1` sites and per-site norm budget `b₀`; the generator of the evolution relative to
the Hermitian `K` is localized on the radius-`⌊ℓ⌋` neighborhood of `Z` with error
`d |V| e^{v|s| - ℓ/2}`. TNLean note, `part2a_mps_information.tex`, lines 381–402. -/
theorem exists_supported_gaussian_integral_graphNeighborhood
    (G : SimpleGraph ι)
    (hSphere : ∀ x : ι, ∀ d : ℕ, (Finset.univ.filter fun y ↦ G.edist x y = d).card ≤ 2)
    (Φ : ManyBody.Interaction (fun _ : ι ↦ Fin q) Y)
    (hDiam : ∀ k, ∀ x ∈ Y k, ∀ z ∈ Y k, G.edist x z ≤ R)
    (hCard : ∀ k, (Y k).card ≤ R + 1)
    (hHerm : ∀ k, (Φ.term k).IsHermitian) (b₀ : ℝ)
    (hBudget : ∀ x : ι, ∑ k ∈ Finset.univ.filter (fun k ↦ x ∈ Y k), ‖Φ.term k‖ ≤ b₀)
    {K : Matrix (ι → Fin q) (ι → Fin q) ℂ} (hK : K.IsHermitian) (Z : Finset ι) (ℓ d : ℝ)
    (hd : 0 ≤ d)
    (hgen : ∀ s : ℝ,
      ‖ManyBody.heisenbergEvolution Φ.hamiltonian s (Φ.hamiltonian - K) -
        ManyBody.regionExpectation (ManyBody.graphNeighborhood G Z ⌊ℓ⌋₊)
          (ManyBody.heisenbergEvolution Φ.hamiltonian s (Φ.hamiltonian - K))‖ ≤
        d * (Fintype.card ι : ℝ) *
          Real.exp ((2 * (R + 1) * |b₀| * Real.exp (2 * R) + 1) * |s| - ℓ / 2)) :
    let n : ℝ := Fintype.card ι
    let K' := Φ.hamiltonian
    let N := fun S : Finset ι ↦ ManyBody.graphNeighborhood G S ⌊ℓ⌋₊
    let a : ℝ := 2 * (2 + 4 * |b₀| * Real.exp (2 * R)) * Real.exp 1 /
      (1 - Real.exp (-(1 / 2)))
    let v : ℝ := 2 * (R + 1) * |b₀| * Real.exp (2 * R) + 1
    ∃ U : ℝ → Matrix (ι → Fin q) (ι → Fin q) ℂ,
      U 0 = 1 ∧
      (∀ t, HasDerivAt U
        ((Complex.I • ManyBody.regionExpectation (N Z)
          (ManyBody.heisenbergEvolution K' t (K' - K))) * U t) t) ∧
      (∀ t, U t ∈ Matrix.unitaryGroup (ι → Fin q) ℂ) ∧
      (∀ t, U t ∈ ManyBody.supportedOperators (fun _ ↦ Fin q) (N Z : Finset ι)) ∧
      ∀ (Q : Finset ι) (W : Matrix (ι → Fin q) (ι → Fin q) ℂ),
        W ∈ ManyBody.supportedOperators (fun _ ↦ Fin q) Q →
        ∀ (η : ℝ≥0) (T : ℝ), 0 ≤ T →
          let B := N (Q ∪ Z)
          let M := ∫ t : ℝ in Set.Icc (-T) T,
            ManyBody.regionExpectation (N Q) (ManyBody.heisenbergEvolution K' t W) * U t
              ∂gaussianReal 0 η
          M ∈ ManyBody.supportedOperators (fun _ ↦ Fin q) B ∧
          ‖M‖ ≤ ‖W‖ ∧
          ‖M - GaussianFilter.gaussianIntertwinerTruncated η T K' K W‖ ≤
            ‖W‖ * (a + d) * n ^ 2 * (1 + T) * Real.exp (v * T - ℓ / 2) := by
  classical
  intro n K' N a v
  have ha : 0 < a := by
    have hden : 0 < 1 - Real.exp (-(1 / 2 : ℝ)) :=
      sub_pos.mpr (Real.exp_lt_one_iff.mpr (by norm_num))
    exact div_pos (by positivity) hden
  have hv : 0 < v := by positivity
  obtain ⟨U, hU0, hU, hunit, hsupport, haverage⟩ :=
    ManyBody.exists_supported_gaussian_integral_of_projection_bounds
      (ManyBody.Interaction.isHermitian_hamiltonian hHerm) hK (N Z)
  refine ⟨U, hU0, hU, hunit, fun t ↦ (hsupport t), ?_⟩
  intro Q W hW η T hT B M
  have hgenT (s : ℝ) (hs : |s| ≤ T) :
      ‖ManyBody.heisenbergEvolution K' s (K' - K) -
        ManyBody.regionExpectation (N Z) (ManyBody.heisenbergEvolution K' s (K' - K))‖ ≤
          d * n * Real.exp (v * T - ℓ / 2) :=
    (hgen s).trans (mul_le_mul_of_nonneg_left
      (Real.exp_mul_sub_le_exp_mul_sub hv.le hs) (mul_nonneg hd (Nat.cast_nonneg _)))
  have hnear (t : ℝ) (ht : |t| ≤ T) :
      ‖ManyBody.heisenbergEvolution K' t W -
        ManyBody.regionExpectation (N Q) (ManyBody.heisenbergEvolution K' t W)‖ ≤
          ‖W‖ * a * n ^ 2 * Real.exp (v * T - ℓ / 2) := by
    have hloc :=
      ManyBody.norm_heisenberg_sub_regionExpectation_graphNeighborhood_le_of_sphere_le_two
        G Φ hHerm R hDiam hCard hSphere b₀ hBudget Q hW ℓ t
    have hc : (Q.card : ℝ) ≤ n := by
      change (Q.card : ℝ) ≤ (Fintype.card ι : ℝ)
      exact_mod_cast Finset.card_le_univ Q
    calc
      _ ≤ a * (Q.card : ℝ) ^ 2 * ‖W‖ * Real.exp (v * |t| - ℓ / 2) := hloc
      _ ≤ a * (Q.card : ℝ) ^ 2 * ‖W‖ * Real.exp (v * T - ℓ / 2) :=
        mul_le_mul_of_nonneg_left (Real.exp_mul_sub_le_exp_mul_sub hv.le ht) (by positivity)
      _ ≤ a * n ^ 2 * ‖W‖ * Real.exp (v * T - ℓ / 2) := by
        apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
        apply mul_le_mul_of_nonneg_right _ (norm_nonneg W)
        exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg _) hc 2) ha.le
      _ = _ := by ring
  have hmono {S S' : Finset ι} (hSS' : S ⊆ S') : N S ⊆ N S' :=
    ManyBody.graphNeighborhood_mono_left hSS'
  obtain ⟨hMsupport, hMnorm, hMerror⟩ := haverage (N Q) B
    (hmono (Finset.subset_union_left : Q ⊆ Q ∪ Z))
    (hmono (Finset.subset_union_right : Z ⊆ Q ∪ Z)) W η T hT
    (a * n ^ 2 * Real.exp (v * T - ℓ / 2))
    (d * n * Real.exp (v * T - ℓ / 2)) (by positivity) (by positivity)
    (fun t ht ↦ by simpa only [mul_assoc] using hnear t ht) hgenT
  refine ⟨hMsupport, hMnorm, hMerror.trans ?_⟩
  have hnsq : n ≤ n ^ 2 := by
    change (Fintype.card ι : ℝ) ≤ (Fintype.card ι : ℝ) ^ 2
    exact_mod_cast (show Fintype.card ι ≤ Fintype.card ι ^ 2 by
      simpa only [pow_two] using Nat.le_mul_self (Fintype.card ι))
  have hscaleT : a * n ^ 2 + d * n * T ≤ (a + d) * n ^ 2 * (1 + T) := by
    calc
      _ ≤ a * n ^ 2 + d * n ^ 2 * T :=
        add_le_add le_rfl (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hnsq hd) hT)
      _ ≤ _ := by
        nlinarith [mul_nonneg hd (sq_nonneg n), mul_nonneg (mul_nonneg ha.le (sq_nonneg n)) hT]
  nlinarith only [mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hscaleT (norm_nonneg W)) (Real.exp_pos (v * T - ℓ / 2)).le]

end Graph

end ManyBody
