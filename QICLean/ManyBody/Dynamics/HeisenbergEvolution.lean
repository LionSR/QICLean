import QICLean.Analysis.HermitianUnitaryPath

/-!
# The Heisenberg picture

The evolution generated by a Hamiltonian `H` is the unitary path `e^{itH}`,
`Matrix.hermitianUnitaryPath H t`. In the Heisenberg picture an operator `A` evolves to
`τ_t(A) = e^{itH} A e^{-itH}`. Nothing about sites is used, so the definition is stated for
matrices on any finite index type; for a system of sites the index type is `ManyBody.Config X`.

Multiplying the Hamiltonian by a real number multiplies the time by the same number. This is
the change of units in Hastings, arXiv:0705.2024v4, eq. `lrb` and the definition of `ξ`,
lines 96–112 and 139–142.

Moved from TNLean, `TNLean/Circuit/LiebRobinson/CommutatorRecursion.lean` (the definition) and
`TimeScaling.lean` (the scaling lemmas) at commit `71c1185e9352a3b5237b37a6840640751da6ca2d`.
Changes: any finite index type in place of `ι → Fin q`; the body is written with
`Matrix.hermitianUnitaryPath`, which unfolds to the former exponential body.

## Main definitions

* `ManyBody.heisenbergEvolution` — the Heisenberg picture `τ_t(A) = e^{itH} A e^{-itH}`.

## Main results

* `ManyBody.heisenbergEvolution_smul`, `ManyBody.heisenbergEvolution_inv_smul_mul` — rescaling
  the energy rescales the time.
-/

open NormedSpace

namespace ManyBody

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The Heisenberg picture `τ_t(A) = e^{itH} A e^{-itH}` of the evolution generated by `H`.
Source: OpenAI, *A two-dimensional area law from a global spectral gap*, Lemma 4.1
(`03-quasilocal.tex`, line 55). -/
noncomputable def heisenbergEvolution (H : Matrix n n ℂ) (t : ℝ) (A : Matrix n n ℂ) :
    Matrix n n ℂ :=
  Matrix.hermitianUnitaryPath H t * A * Matrix.hermitianUnitaryPath H (-t)

/-- The Heisenberg picture written with the matrix exponential. -/
theorem heisenbergEvolution_def (H : Matrix n n ℂ) (t : ℝ) (A : Matrix n n ℂ) :
    heisenbergEvolution H t A =
      exp (t • (Complex.I • H)) * A * exp ((-t) • (Complex.I • H)) :=
  rfl

/-- Rescaling the energy by `c` rescales time by `c` in the Heisenberg picture.
Hastings, arXiv:0705.2024v4, lines 96–112 and 139–142. -/
theorem heisenbergEvolution_smul (H : Matrix n n ℂ) (c t : ℝ) (A : Matrix n n ℂ) :
    heisenbergEvolution ((c : ℂ) • H) t A = heisenbergEvolution H (c * t) A := by
  simp only [heisenbergEvolution_def, smul_comm Complex.I (c : ℂ), ← Complex.coe_smul,
    smul_smul, mul_comm c t, Complex.ofReal_mul, Complex.ofReal_neg, mul_assoc, neg_mul]

/-- Dividing the Hamiltonian by a nonzero energy scale and multiplying time by that scale
leaves the Heisenberg picture unchanged. Hastings, arXiv:0705.2024v4, lines 96–112 and
139–142. -/
theorem heisenbergEvolution_inv_smul_mul (H : Matrix n n ℂ) {Δ : ℝ} (hΔ : Δ ≠ 0) (t : ℝ)
    (A : Matrix n n ℂ) :
    heisenbergEvolution (((Δ⁻¹ : ℝ) : ℂ) • H) (Δ * t) A = heisenbergEvolution H t A := by
  rw [heisenbergEvolution_smul, ← mul_assoc, inv_mul_cancel₀ hΔ, one_mul]

end ManyBody
