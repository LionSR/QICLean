import QICLean.ManyBody.Dynamics.ProjectedRelativeEvolution

/-!
# Products of evolutions on disjoint regions

Localized interaction-picture generators on pairwise disjoint regions have unitary evolutions
whose ordered product is generated by their sum. The product approximates the relative
evolution for the sum of the terms, with error at most the sum of the generator errors times
the elapsed time. This is the analytic assembly used in the block approximation of
one-dimensional evolution in Osborne, arXiv:quant-ph/0508031v2, and Huang, arXiv:1406.6355v6,
Section 5.4. The regions and their projected generators are supplied; chain partitions,
Lieb–Robinson localization estimates and bond-dimension bounds belong to the applications.

Moved from TNLean, `TNLean/Circuit/DisjointRelativeEvolution.lean` at commit
`71c1185e9352a3b5237b37a6840640751da6ca2d`. Changes: an arbitrary system of sites in place of
`ι → Fin q`; `ManyBody.regionExpectation` in place of `siteExpectation q`, so `[NeZero q]` is
gone; the ordered-product rule `MatrixEvolution.hasDerivAt_ordered_prod_of_commute` moved to
`QICLean/Analysis/UnitaryEvolution`.

## Main definitions

* `ManyBody.disjointProjectedPropagator` — the projected relative evolutions on the regions.

## Main results

* `ManyBody.disjointProjectedPropagator_spec`,
  `ManyBody.exists_disjoint_projected_propagator_approximation` — the ordered product
  approximates the relative evolution of the sum.
-/

open scoped BigOperators Matrix Matrix.Norms.L2Operator

namespace ManyBody

variable {V : Type*} [Fintype V] [DecidableEq V] {X : V → Type*} [∀ v, Fintype (X v)]
  [∀ v, DecidableEq (X v)]

/-- **The propagators of projected interaction-picture terms on disjoint regions**: on the
region `K j`, the projected relative evolution of `A` against `A - B j`. Osborne,
arXiv:quant-ph/0508031v2, equations (2)–(13); Huang, arXiv:1406.6355v6, Section 5.4. -/
noncomputable def disjointProjectedPropagator {m : ℕ}
    (K : Fin m → Finset V) {A : Matrix (Config X) (Config X) ℂ} (hA : A.IsHermitian)
    (B : Fin m → Matrix (Config X) (Config X) ℂ) (hB : ∀ j, (B j).IsHermitian)
    (j : Fin m) : ℝ → Matrix (Config X) (Config X) ℂ :=
  projectedRelativeEvolution (K j) hA (hA.sub (hB j))

/-- The chosen evolutions of projected interaction-picture terms on disjoint regions.
Their single ordered product approximates the relative evolution for the sum of the
terms, with error at most the sum of the generator errors times elapsed time.

This is an auxiliary assembly statement for Osborne, arXiv:quant-ph/0508031v2,
equations (2)–(13), and Huang, arXiv:1406.6355v6, Section 5.4. The hypotheses do not yet
choose a chain partition or prove its generator localization estimates. -/
theorem disjointProjectedPropagator_spec {m : ℕ}
    (K : Fin m → Finset V)
    (hK : Pairwise fun j k ↦ Disjoint (K j) (K k))
    {A : Matrix (Config X) (Config X) ℂ} (hA : A.IsHermitian)
    (B : Fin m → Matrix (Config X) (Config X) ℂ)
    (hB : ∀ j, (B j).IsHermitian) :
    let U := disjointProjectedPropagator K hA B hB
    (∀ j, U j 0 = 1) ∧
      (∀ j t, HasDerivAt (U j)
        ((Complex.I • regionExpectation (K j) (heisenbergEvolution A t (B j))) * U j t) t) ∧
      (∀ j t, U j t ∈ Matrix.unitaryGroup (Config X) ℂ) ∧
      (∀ j t, U j t ∈ supportedOperators X (K j)) ∧
      ∀ (t : ℝ) (ε : Fin m → ℝ),
        (∀ j s, s ∈ Set.uIcc 0 t →
          ‖heisenbergEvolution A s (B j) -
            regionExpectation (K j) (heisenbergEvolution A s (B j))‖ ≤ ε j) →
        ‖Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
            Matrix.hermitianUnitaryPath A (-t) *
              (List.ofFn fun j ↦ U j t).prod‖ ≤ (∑ j, ε j) * |t| := by
  classical
  intro U
  have hspec (j : Fin m) := projectedRelativeEvolution_spec (K j) hA (hA.sub (hB j))
  have hU0 (j : Fin m) : U j 0 = 1 := (hspec j).1
  have hUd (j : Fin m) (t : ℝ) : HasDerivAt (U j)
      ((Complex.I • regionExpectation (K j) (heisenbergEvolution A t (B j))) * U j t) t := by
    have hcancel : A - (A - B j) = B j := by abel
    simpa only [U, disjointProjectedPropagator, hcancel] using
      (hspec j).2.1 t
  have hUunit (j : Fin m) (t : ℝ) : U j t ∈ Matrix.unitaryGroup (Config X) ℂ :=
    (hspec j).2.2.1 t
  have hUsupport (j : Fin m) (t : ℝ) : U j t ∈ supportedOperators X (K j) :=
    (hspec j).2.2.2.1 t
  refine ⟨hU0, hUd, hUunit, hUsupport, ?_⟩
  intro t ε herror
  let G : ℝ → Matrix (Config X) (Config X) ℂ :=
    fun s ↦ heisenbergEvolution A s (∑ j, B j)
  let F : ℝ → Matrix (Config X) (Config X) ℂ :=
    fun s ↦ ∑ j, regionExpectation (K j) (heisenbergEvolution A s (B j))
  have hBsum : (∑ j, B j).IsHermitian :=
    (isSelfAdjoint_sum _ fun j _ ↦ (hB j).isSelfAdjoint).isHermitian
  have hGc : Continuous G :=
    (MatrixEvolution.contDiff_projectedGenerator LinearMap.id A (∑ j, B j) 1).continuous
  have hFc : Continuous F := continuous_finsetSum _ fun j _ ↦
    (MatrixEvolution.contDiff_projectedGenerator (regionExpectationLM (K j)) A (B j) 1).continuous
  have hGh (s : ℝ) : (G s).IsHermitian :=
    MatrixEvolution.isHermitian_projectedGenerator LinearMap.id (fun _ h ↦ h) hA hBsum s
  have hFh (s : ℝ) : (F s).IsHermitian := (isSelfAdjoint_sum _ fun j _ ↦
    (MatrixEvolution.isHermitian_projectedGenerator (regionExpectationLM (K j))
      (fun _ h ↦ isHermitian_regionExpectation h) hA (hB j) s).isSelfAdjoint).isHermitian
  have hproduct (s : ℝ) :
      HasDerivAt (fun s ↦ (List.ofFn fun j ↦ U j s).prod)
        ((Complex.I • F s) * (List.ofFn fun j ↦ U j s).prod) s :=
    MatrixEvolution.hasDerivAt_ordered_prod_of_commute U
      (fun j s ↦ regionExpectation (K j) (heisenbergEvolution A s (B j))) s
      (fun j ↦ hUd j s) (fun j k hjk ↦
        commute_of_mem_supportedOperators_of_disjoint (hUsupport j s)
          (regionExpectation_mem_supportedOperators (K k) _) (hK hjk))
  have hrelative (s : ℝ) :
      HasDerivAt (fun s ↦ Matrix.hermitianUnitaryPath A s *
        Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-s))
        ((Complex.I • G s) * (Matrix.hermitianUnitaryPath A s *
          Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-s))) s := by
    have hcancel : A - (A - ∑ j, B j) = ∑ j, B j := by abel
    simpa only [hcancel, G, heisenbergEvolution] using
      MatrixEvolution.hasDerivAt_hermitianUnitaryPath_mul_neg A (A - ∑ j, B j) s
  have hcompare := MatrixEvolution.norm_sub_le_of_generator_bound hGc hFc hGh hFh
    (by simp) (by simp [hU0]) hrelative hproduct t (∑ j, ε j) (fun s hs ↦ by
      change ‖Matrix.hermitianUnitaryPath A s * (∑ j, B j) *
          Matrix.hermitianUnitaryPath A (-s) -
          ∑ j, regionExpectation (K j) (heisenbergEvolution A s (B j))‖ ≤ _
      rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ ↦ herror j s hs))
  calc
    _ = ‖Matrix.hermitianUnitaryPath A t *
        (Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
          Matrix.hermitianUnitaryPath A (-t) * (List.ofFn fun j ↦ U j t).prod)‖ :=
      (CStarRing.norm_mem_unitary_mul _
        (SpectralFilter.hermitianUnitaryPath_mem_unitary hA t)).symm
    _ = ‖Matrix.hermitianUnitaryPath A t *
        Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
        (List.ofFn fun j ↦ U j t).prod‖ := by
      rw [mul_sub, ← mul_assoc, SpectralFilter.hermitianUnitaryPath_mul_neg, one_mul]
    _ ≤ _ := hcompare


/-- Evolutions of projected interaction-picture terms on disjoint regions whose ordered
product approximates the relative evolution for the sum of the terms: the existence form
of `disjointProjectedPropagator_spec`. Osborne, arXiv:quant-ph/0508031v2,
equations (2)–(13); Huang, arXiv:1406.6355v6, Section 5.4. -/
theorem exists_disjoint_projected_propagator_approximation {m : ℕ}
    (K : Fin m → Finset V)
    (hK : Pairwise fun j k ↦ Disjoint (K j) (K k))
    {A : Matrix (Config X) (Config X) ℂ} (hA : A.IsHermitian)
    (B : Fin m → Matrix (Config X) (Config X) ℂ)
    (hB : ∀ j, (B j).IsHermitian) :
    ∃ U : Fin m → ℝ → Matrix (Config X) (Config X) ℂ,
      (∀ j, U j 0 = 1) ∧
      (∀ j t, HasDerivAt (U j)
        ((Complex.I • regionExpectation (K j) (heisenbergEvolution A t (B j))) * U j t) t) ∧
      (∀ j t, U j t ∈ Matrix.unitaryGroup (Config X) ℂ) ∧
      (∀ j t, U j t ∈ supportedOperators X (K j)) ∧
      ∀ (t : ℝ) (ε : Fin m → ℝ),
        (∀ j s, s ∈ Set.uIcc 0 t →
          ‖heisenbergEvolution A s (B j) -
            regionExpectation (K j) (heisenbergEvolution A s (B j))‖ ≤ ε j) →
        ‖Matrix.hermitianUnitaryPath (A - ∑ j, B j) (-t) -
            Matrix.hermitianUnitaryPath A (-t) *
              (List.ofFn fun j ↦ U j t).prod‖ ≤ (∑ j, ε j) * |t| :=
  ⟨disjointProjectedPropagator K hA B hB, disjointProjectedPropagator_spec K hK hA B hB⟩

end ManyBody
