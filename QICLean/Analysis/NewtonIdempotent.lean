/-!
# Newton correction of approximate idempotents

The Newton correction `x ↦ 3x² − 2x³` replaces the idempotency defect `d = x² − x` by
`d²(4d − 3)`. If the initial defect has norm at most `1/16`, the corrections converge in every
complete normed ring with `‖1‖ ≤ 1`, and the limit is idempotent.

Near an idempotent matrix, the corrections therefore converge uniformly. Applying the
convergence theorem in the Banach algebra of bounded continuous matrix-valued functions gives a
continuous idempotent family with the prescribed base value. Each iterate lies in the algebra
generated by the original matrix; this algebra is finite-dimensional and closed, so the limit
lies in it as well. Hermiticity is not needed.

This is a finite-dimensional ingredient of the continuity argument of arXiv:1010.3732,
Section II.F.2, lines 953–993; the remaining steps of that argument are recorded in
https://github.com/LionSR/TNLean/blob/main/docs/paper-gaps/spc11_spt_interpolation_upper_range.tex.

Moved from TNLean, `TNLean/Algebra/NewtonIdempotentConvergence.lean` and
`TNLean/Algebra/ContinuousNearbyIdempotent.lean` at commit `49b78ed821` (Apache-2.0). Changes:
the two files are merged.

## Main results

* `idempotent_newton_tendsto_of_small_defect`: the Newton corrections of an element of defect
  at most `1/16` converge to an idempotent.
* `Matrix.exists_local_continuous_idempotent_in_adjoin`: an idempotent matrix extends locally to
  a continuous idempotent family lying in the algebra generated by each nearby matrix.
-/

/-- The Newton idempotent correction squares the old defect. -/
theorem idempotent_newton_defect {A : Type*} [Ring A] (x : A) :
    (3 * x ^ 2 - 2 * x ^ 3) ^ 2 - (3 * x ^ 2 - 2 * x ^ 3) =
      (x ^ 2 - x) ^ 2 * (4 * (x ^ 2 - x) - 3) := by
  noncomm_ring [smul_smul]

/-- The Newton correction differs from the original element by its defect
multiplied by twice the original element minus one. -/
theorem idempotent_newton_sub {A : Type*} [Ring A] (x : A) :
    (3 * x ^ 2 - 2 * x ^ 3) - x = -(2 * x - 1) * (x ^ 2 - x) := by
  noncomm_ring [smul_smul]

/-- Twice the corrected element minus one factors through twice the original
element minus one and one minus twice its defect. -/
theorem idempotent_newton_twice_sub_one {A : Type*} [Ring A] (x : A) :
    2 * (3 * x ^ 2 - 2 * x ^ 3) - 1 =
      (2 * x - 1) * (1 - 2 * (x ^ 2 - x)) := by
  noncomm_ring [smul_smul]

open Filter Topology

private theorem norm_natCast_bound {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (n : ℕ) : ‖(n : A)‖ ≤ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc
      ‖(↑(n + 1) : A)‖ = ‖(n : A) + 1‖ := by simp
      _ ≤ ‖(n : A)‖ + ‖(1 : A)‖ := norm_add_le _ _
      _ ≤ (n : ℝ) + 1 := add_le_add ih hOne
      _ = ↑(n + 1) := by simp

private theorem newton_defect_bound {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) :
    ‖(3 * x ^ 2 - 2 * x ^ 3) ^ 2 - (3 * x ^ 2 - 2 * x ^ 3)‖ ≤
      ‖x ^ 2 - x‖ ^ 2 * (4 * ‖x ^ 2 - x‖ + 3) := by
  rw [idempotent_newton_defect]
  have h4 : ‖(4 : A) * (x ^ 2 - x) - 3‖ ≤ 4 * ‖x ^ 2 - x‖ + 3 := by
    calc
      _ ≤ ‖(4 : A) * (x ^ 2 - x)‖ + ‖(3 : A)‖ := norm_sub_le _ _
      _ ≤ ‖(4 : A)‖ * ‖x ^ 2 - x‖ + ‖(3 : A)‖ :=
        add_le_add (norm_mul_le _ _) le_rfl
      _ ≤ 4 * ‖x ^ 2 - x‖ + 3 := add_le_add
        (mul_le_mul_of_nonneg_right (norm_natCast_bound hOne 4) (norm_nonneg _))
        (norm_natCast_bound hOne 3)
  have hsq : ‖(x ^ 2 - x) ^ 2‖ ≤ ‖x ^ 2 - x‖ ^ 2 := by
    rw [pow_two, pow_two]
    exact (norm_mul_le (x * x - x) (x * x - x)).trans_eq (pow_two _).symm
  exact (norm_mul_le _ _).trans
    (mul_le_mul hsq h4 (norm_nonneg _) (sq_nonneg _))

private theorem newton_defect_contract {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) (h : ‖x ^ 2 - x‖ ≤ 1 / 16) :
    ‖(3 * x ^ 2 - 2 * x ^ 3) ^ 2 - (3 * x ^ 2 - 2 * x ^ 3)‖ ≤ (1 / 4 : ℝ) * ‖x ^ 2 - x‖ := by
  refine (newton_defect_bound hOne x).trans ?_
  have hm : ‖x ^ 2 - x‖ * (4 * ‖x ^ 2 - x‖ + 3) ≤ 1 / 4 := by
    calc
      _ ≤ (1 / 16 : ℝ) * 4 := mul_le_mul h (by linarith)
        (by positivity) (by norm_num)
      _ = 1 / 4 := by norm_num
  calc
    _ = ‖x ^ 2 - x‖ * (‖x ^ 2 - x‖ * (4 * ‖x ^ 2 - x‖ + 3)) := by ring
    _ ≤ ‖x ^ 2 - x‖ * (1 / 4) := mul_le_mul_of_nonneg_left hm (norm_nonneg _)
    _ = (1 / 4) * ‖x ^ 2 - x‖ := by ring

private theorem newton_center_bound {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) (h : ‖x ^ 2 - x‖ ≤ 1 / 16) :
    ‖2 * (3 * x ^ 2 - 2 * x ^ 3) - 1‖ ≤ 2 * ‖2 * x - 1‖ := by
  rw [idempotent_newton_twice_sub_one]
  have hk : ‖(1 : A) - 2 * (x ^ 2 - x)‖ ≤ 2 := by
    calc
      _ ≤ ‖(1 : A)‖ + ‖(2 : A) * (x ^ 2 - x)‖ := norm_sub_le _ _
      _ ≤ 1 + 2 * ‖x ^ 2 - x‖ := add_le_add hOne
        ((norm_mul_le _ _).trans
          (mul_le_mul_of_nonneg_right (norm_natCast_bound hOne 2) (norm_nonneg _)))
      _ ≤ 2 := by linarith
  exact ((norm_mul_le _ _).trans
    (mul_le_mul_of_nonneg_left hk (norm_nonneg _))).trans_eq (mul_comm _ _)

private theorem newton_iterate_bounds {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) (h : ‖x ^ 2 - x‖ ≤ 1 / 16) (n : ℕ) :
    ‖((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x ^ 2 -
        ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x‖ ≤ (1 / 4 : ℝ) ^ n * ‖x ^ 2 - x‖ ∧
    ‖2 * ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x - 1‖ ≤ (2 : ℝ) ^ n * ‖2 * x - 1‖ := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hsmall : ‖((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x ^ 2 -
        ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x‖ ≤ 1 / 16 := by
      calc
        _ ≤ (1 / 4 : ℝ) ^ n * ‖x ^ 2 - x‖ := ih.1
        _ ≤ 1 * ‖x ^ 2 - x‖ := mul_le_mul_of_nonneg_right
          (pow_le_one₀ (by norm_num) (by norm_num)) (norm_nonneg _)
        _ ≤ 1 / 16 := by simpa using h
    simp only [Function.iterate_succ_apply']
    constructor
    · exact ((newton_defect_contract hOne _ hsmall).trans
        (mul_le_mul_of_nonneg_left ih.1 (by norm_num))).trans_eq (by
          rw [pow_succ]
          ring)
    · exact ((newton_center_bound hOne _ hsmall).trans
        (mul_le_mul_of_nonneg_left ih.2 (by norm_num))).trans_eq (by
          rw [pow_succ]
          ring)

/-- For an initial defect at most 1 / 16, successive Newton corrections have
geometrically summable increments. The estimate needs only norm submultiplicativity
and the bound ‖1‖≤1; it also applies to the zero algebra. -/
theorem idempotent_newton_increment_bound {A : Type*} [NormedRing A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) (h : ‖x ^ 2 - x‖ ≤ 1 / 16) (n : ℕ) :
    ‖((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n + 1]) x -
      ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x‖ ≤
      (‖2 * x - 1‖ * ‖x ^ 2 - x‖) * (1 / 2 : ℝ) ^ n := by
  rw [Function.iterate_succ_apply', idempotent_newton_sub, neg_mul, norm_neg]
  have hb := newton_iterate_bounds hOne x h n
  refine (norm_mul_le _ _).trans
    ((mul_le_mul hb.2 hb.1 (norm_nonneg _) (by positivity)).trans_eq ?_)
  calc
    _ = (‖2 * x - 1‖ * ‖x ^ 2 - x‖) * ((2 : ℝ) ^ n * (1 / 4 : ℝ) ^ n) := by ring
    _ = _ := by rw [← mul_pow]; norm_num

/-- Newton correction converges to an idempotent when its initial defect is at
most 1 / 16. Completeness is used only after the geometric increment estimate. -/
theorem idempotent_newton_tendsto_of_small_defect {A : Type*}
    [NormedRing A] [CompleteSpace A]
    (hOne : ‖(1 : A)‖ ≤ 1) (x : A) (hDef : ‖x ^ 2 - x‖ ≤ 1 / 16) :
    ∃ p : A, Tendsto (fun n => ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x)
      atTop (𝓝 p) ∧ p ^ 2 = p := by
  have hC : CauchySeq (fun n => ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x) :=
    SeminormedAddCommGroup.cauchySeq_of_le_geometric (by norm_num : (1 / 2 : ℝ) < 1)
      (fun n => by
        rw [norm_sub_rev]
        exact idempotent_newton_increment_bound hOne x hDef n)
  obtain ⟨p, hp⟩ := cauchySeq_tendsto_of_complete hC
  have hzero : Tendsto (fun n => (1 / 4 : ℝ) ^ n * ‖x ^ 2 - x‖) atTop (𝓝 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one
      (by norm_num : (0 : ℝ) ≤ 1 / 4) (by norm_num : (1 / 4 : ℝ) < 1)).mul_const ‖x ^ 2 - x‖
  have hnorm : Tendsto (fun n =>
      ‖((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x ^ 2 -
        ((fun x : A => 3 * x ^ 2 - 2 * x ^ 3)^[n]) x‖) atTop (𝓝 0) :=
    squeeze_zero (fun _ => norm_nonneg _)
      (fun n => (newton_iterate_bounds hOne x hDef n).1) hzero
  have hlimit : p ^ 2 - p = 0 := tendsto_nhds_unique
    ((hp.pow 2).sub hp) (tendsto_zero_iff_norm_tendsto_zero.mpr hnorm)
  exact ⟨p, hp, sub_eq_zero.mp hlimit⟩

open scoped Matrix Matrix.Norms.L2Operator Topology BoundedContinuousFunction
open Filter

namespace Matrix

private theorem newton_iterate_mem_adjoin {n : ℕ}
    (X : Matrix (Fin n) (Fin n) ℂ) (k : ℕ) :
    ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) X ∈ Algebra.adjoin ℂ {X} := by
  let S := Algebra.adjoin ℂ {X}
  induction k with
  | zero => exact Algebra.subset_adjoin (Set.mem_singleton X)
  | succ k hk =>
    rw [Function.iterate_succ_apply']
    exact S.sub_mem (S.mul_mem (S.natCast_mem 3) (S.pow_mem hk 2))
      (S.mul_mem (S.natCast_mem 2) (S.pow_mem hk 3))

private theorem newton_iterate_eq_of_idempotent {n : ℕ}
    (X : Matrix (Fin n) (Fin n) ℂ) (hX : IsIdempotentElem X) (k : ℕ) :
    ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) X = X := by
  have hX₂ : X ^ 2 = X := by simpa only [pow_two] using hX.eq
  have hX₃ : X ^ 3 = X := by rw [pow_succ, hX₂, hX.eq]
  apply Function.iterate_fixed
  rw [hX₂, hX₃]
  noncomm_ring [smul_smul]

private theorem newton_limit_mem_adjoin {n : ℕ}
    (X P : Matrix (Fin n) (Fin n) ℂ)
    (hP : Tendsto (fun k => ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) X)
      atTop (𝓝 P)) : P ∈ Algebra.adjoin ℂ {X} :=
  (Algebra.adjoin ℂ {X}).toSubmodule.closed_of_finiteDimensional.mem_of_tendsto hP
    (Eventually.of_forall (newton_iterate_mem_adjoin X))


/-- An idempotent matrix extends locally to a continuous idempotent lying in
the complex algebra generated by each nearby matrix. Hermiticity is unnecessary. -/
theorem exists_local_continuous_idempotent_in_adjoin
    {T : Type*} [TopologicalSpace T] {n : ℕ}
    (X : T → Matrix (Fin n) (Fin n) ℂ) (hX : Continuous X)
    (t₀ : T) (hBase : IsIdempotentElem (X t₀)) :
    ∃ (S : Set T) (P : T → Matrix (Fin n) (Fin n) ℂ),
      IsOpen S ∧ t₀ ∈ S ∧ ContinuousOn P S ∧ P t₀ = X t₀ ∧
      ∀ t ∈ S, IsIdempotentElem (P t) ∧ P t ∈ Algebra.adjoin ℂ {X t} := by
  classical
  let S := {t | ‖X t ^ 2 - X t‖ < 1 / 16 ∧ ‖X t‖ < ‖X t₀‖ + 1}
  have hS : IsOpen S := (isOpen_lt ((hX.pow 2).sub hX).norm continuous_const).inter
    (isOpen_lt hX.norm continuous_const)
  have ht₀ : t₀ ∈ S := by
    have hPow : X t₀ ^ 2 = X t₀ := by simpa only [pow_two] using hBase.eq
    constructor
    · simp only [hPow, sub_self, norm_zero]
      norm_num
    · exact lt_add_one _
  let f : S →ᵇ Matrix (Fin n) (Fin n) ℂ :=
    BoundedContinuousFunction.ofNormedAddCommGroup (fun t : S => X t)
      (hX.comp continuous_subtype_val) (‖X t₀‖ + 1) (fun t => t.property.2.le)
  have hf : ∀ t : S, f t = X t := fun _ => rfl
  have hOneMatrix : ‖(1 : Matrix (Fin n) (Fin n) ℂ)‖ ≤ 1 := by
    rcases subsingleton_or_nontrivial (Matrix (Fin n) (Fin n) ℂ) with h | h
    · let := h
      rw [show (1 : Matrix (Fin n) (Fin n) ℂ) = 0 from Subsingleton.elim _ _, norm_zero]
      norm_num
    · let := h
      exact (CStarRing.norm_one).le
  have hOne : ‖(1 : S →ᵇ Matrix (Fin n) (Fin n) ℂ)‖ ≤ 1 :=
    (BoundedContinuousFunction.norm_const_le _).trans hOneMatrix
  have hDef : ‖f ^ 2 - f‖ ≤ 1 / 16 := by
    apply (BoundedContinuousFunction.norm_le (by norm_num)).mpr
    intro t
    simpa only [BoundedContinuousFunction.sub_apply, BoundedContinuousFunction.pow_apply, hf]
      using t.property.1.le
  obtain ⟨p, hLim, hpPow⟩ := idempotent_newton_tendsto_of_small_defect hOne f hDef
  have hp : IsIdempotentElem p := by simpa only [pow_two, IsIdempotentElem] using hpPow
  have hEval : ∀ t : S, ∀ k,
      (((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) f) t =
        ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) (X t) := by
    intro t k
    have hSemi : Function.Semiconj
        (fun g : S →ᵇ Matrix (Fin n) (Fin n) ℂ => g t)
        (fun x => 3 * x ^ 2 - 2 * x ^ 3) (fun x => 3 * x ^ 2 - 2 * x ^ 3) := by
      intro g
      rfl
    exact hSemi.iterate_right k f
  have hPoint : ∀ t : S,
      Tendsto (fun k => ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) (X t))
        atTop (𝓝 (p t)) := by
    intro t
    simpa only [Function.comp_def, hEval] using
      ((BoundedContinuousFunction.lipschitz_eval_const t).continuous.tendsto p).comp hLim
  let P := fun t : T => if ht : t ∈ S then p ⟨t, ht⟩ else X t
  refine ⟨S, P, hS, ht₀, ?_, ?_, ?_⟩
  · rw [continuousOn_iff_continuous_domRestrict]
    have hRestrict : S.domRestrict P = (p : S → Matrix (Fin n) (Fin n) ℂ) := by
      funext t
      simp only [Set.domRestrict_apply, P, dite_eq_left t.property]
    rw [hRestrict]
    exact p.continuous
  · simp only [P, dite_eq_left ht₀]
    have hConst : Tendsto (fun k => ((fun x => 3 * x ^ 2 - 2 * x ^ 3)^[k]) (X t₀))
        atTop (𝓝 (X t₀)) := by
      simpa only [newton_iterate_eq_of_idempotent _ hBase] using
        (tendsto_const_nhds : Tendsto (fun _ : ℕ => X t₀) atTop (𝓝 (X t₀)))
    exact tendsto_nhds_unique (hPoint ⟨t₀, ht₀⟩) hConst
  · intro t ht
    have hPt : P t = p ⟨t, ht⟩ := by simp only [P, dite_eq_left ht]
    rw [hPt]
    refine ⟨?_, newton_limit_mem_adjoin _ _ (hPoint ⟨t, ht⟩)⟩
    exact congrArg (fun g : S →ᵇ Matrix (Fin n) (Fin n) ℂ => g ⟨t, ht⟩) hp.eq

end Matrix
